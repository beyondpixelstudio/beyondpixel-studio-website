---
/**
 * Lotus Bloom — the hero's 3D scene
 *
 * The mark IS the scene. Rather than decorating the hero with generic WebGL
 * (floating spheres, particle fields, a distorted blob), this builds the actual
 * logo in three dimensions: three rings of lotus petals around a working camera
 * aperture, lit by the same two practicals the CSS `.cine__bloom` layer paints.
 * The key light sits at 78%/8% in CSS; the WebGL key sits upper-right. They are
 * the same light, so the canvas and the page agree about where the sun is.
 *
 * -------------------------------------------------------------------------
 * WHAT PROTECTS THE PAGE FROM IT
 *
 * A 150KB renderer for decoration is only defensible if it can never cost the
 * user anything. Five gates, all of which must pass before three.js is even
 * fetched — the import is dynamic, so a device that fails a gate downloads none
 * of it:
 *
 *   1. after `load` + idle — never competes with LCP or with font swap
 *   2. `prefers-reduced-motion: no-preference` — this is a large moving object
 *   3. viewport >= 1100px — see WIDTH below
 *   4. WebGL actually available — a context probe, not a UA sniff
 *   5. `deviceMemory` >= 4 where reported — low-end Android is the real risk
 *
 * WIDTH: the gate and the CSS offset are the SAME number, deliberately. The
 * scene is composed as a two-column hero — copy left, flower right. Below that
 * width there is no right column, so the flower lands behind the H1 and reads
 * as a coloured smear that costs the headline its contrast and gains nothing.
 * Running it there is worse than not running it, so it does not run there. The
 * breakpoint is declared once, in JS, as WIDE below. The stylesheet needs no
 * copy of it: the layout shift is keyed off `.is-live`, which by construction
 * only appears when the gate has already passed.
 *
 * And once running: an IntersectionObserver halts the loop the moment the hero
 * leaves the viewport, so scrolling the page does not spin a GPU on a scene
 * nobody can see.
 *
 * The static fallback underneath is not a blank box — it is a complete CSS
 * treatment that the majority of mobile visitors will see as the intended
 * design. It has to look finished on its own, because for most of this
 * audience it IS the design.
 * -------------------------------------------------------------------------
 */
---

<div class="bloom" aria-hidden="true">
  {/* The fallback. Painted always; the canvas fades in over it if it earns the
      right to. Concentric conic rings read as an aperture at a glance. */}
  <div class="bloom__static">
    <span class="bloom__ring bloom__ring--out"></span>
    <span class="bloom__ring bloom__ring--mid"></span>
    <span class="bloom__ring bloom__ring--core"></span>
  </div>

  <canvas class="bloom__gl" data-bloom></canvas>
</div>

<script>
  import type * as THREE_NS from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-bloom]');

  /* -- Gates ------------------------------------------------------------- */

  const webglOK = () => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };

  /** The two-column threshold. Declared here and nowhere else. */
  const WIDE = 1100;

  const allowed = () =>
    !!canvas &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
    window.matchMedia(`(min-width: ${WIDE}px)`).matches &&
    // `deviceMemory` is Chromium-only. Absent (Safari, Firefox) is not a
    // failure — only a reported value below 4 is.
    ((navigator as any).deviceMemory ?? 8) >= 4 &&
    webglOK();

  const idle = (fn: () => void) =>
    'requestIdleCallback' in window
      ? (window as any).requestIdleCallback(fn, { timeout: 2600 })
      : setTimeout(fn, 900);

  if (allowed()) {
    if (document.readyState === 'complete') idle(() => void boot());
    else window.addEventListener('load', () => idle(() => void boot()), { once: true });
  }

  /* -- Scene ------------------------------------------------------------- */

  async function boot() {
    const THREE = (await import('three')) as typeof THREE_NS;
    const gl = canvas!;

    /* The logo's colour sweep, sampled left to right off the supplied artwork:
       orange-red, orange, rose, magenta, violet, indigo, ocean. Petals take
       their colour from their position in the ring, so the full sweep rotates
       past the viewer exactly as it reads in the flat mark. */
    const RAMP = ['#E8532A', '#F0863C', '#C4485F', '#9B2FC0', '#5B2AC0', '#2E3A9E', '#1B6CA8'].map(
      (h) => new THREE.Color(h)
    );

    const rampAt = (t: number) => {
      const x = Math.min(Math.max(t, 0), 1) * (RAMP.length - 1);
      const i = Math.min(Math.floor(x), RAMP.length - 2);
      return RAMP[i].clone().lerp(RAMP[i + 1], x - i);
    };

    const scene = new THREE.Scene();

    // A long lens. Wide-angle on a radial subject exaggerates the near petals
    // and the flower stops reading as symmetrical — the same reason a portrait
    // is not shot on 24mm.
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
    // Pulled back from 11.4. The bloom was filling most of the right half of
    // the hero and competing with the headline rather than sitting beside it.
    camera.position.set(0, 0.15, 14.6);

    const renderer = new THREE.WebGLRenderer({
      canvas: gl,
      antialias: true,
      alpha: true, // the cine grain and vignette must show through
      powerPreference: 'high-performance',
    });
    renderer.setClearAlpha(0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.12;

    /* ---- Petal geometry ------------------------------------------------
       A lotus petal is a pointed oval that CUPS. Extruding a flat outline gets
       the silhouette but reads as a paper fan; the vertex pass below dishes it
       along both axes, and that single step is the difference between a ring of
       cards and a flower. */
    const petalGeo = (w: number, h: number, cup: number) => {
      const s = new THREE.Shape();
      s.moveTo(0, 0);
      s.bezierCurveTo(w, h * 0.2, w * 0.9, h * 0.66, 0, h);
      s.bezierCurveTo(-w * 0.9, h * 0.66, -w, h * 0.2, 0, 0);

      const g = new THREE.ExtrudeGeometry(s, {
        depth: 0.035,
        bevelEnabled: true,
        bevelThickness: 0.022,
        bevelSize: 0.022,
        bevelSegments: 2,
        curveSegments: 22,
      });

      // Dish it: quadratic across the width, and a gentle backward bend up the
      // length so the tip flares away from the core.
      const pos = g.attributes.position as THREE_NS.BufferAttribute;
      for (let i = 0; i < pos.count; i++) {
        const x = pos.getX(i);
        const y = pos.getY(i);
        const t = y / h;
        pos.setZ(i, pos.getZ(i) - cup * (x * x * 2.6 + t * t * 0.85));
      }
      pos.needsUpdate = true;
      g.computeVertexNormals();
      g.translate(0, 0, 0);
      return g;
    };

    /* ---- Rings ---------------------------------------------------------
       Three rings, matching the mark: broad outer petals lying nearly flat, a
       shorter upright mid ring, and the thin inner slivers. Each ring is its
       own group so it can breathe at its own rate. */
    type Ring = {
      group: THREE_NS.Group;
      rest: number; // pitch when fully bloomed, radians
      close: number; // pitch when closed into a bud
      spin: number; // own rotation rate
      pivots: THREE_NS.Group[];
    };

    const bloom = new THREE.Group();
    const rings: Ring[] = [];

    /* THE ROSETTE PLANE.
       Petals radiate around Z — the axis pointing at the viewer — so the ring
       is a rosette in the picture plane, which is the pose the flat mark is
       drawn in. Arranging them around Y instead builds a flower seen from the
       side: correct botany, but it presents the ring edge-on and renders as a
       horizontal spray with no silhouette. The mark is the brief here, not the
       botany.

       `rest` is therefore the petal's tilt OUT of that plane at full bloom —
       near zero for the outer ring, rising inward so the rosette cups toward
       the viewer. `close` folds it forward into a bud for the entry animation.
       `z` stacks the rings in depth so the inner ones sit genuinely in front. */
    const RING_SPEC = [
      { n: 14, w: 0.52, h: 2.15, cup: 0.44, rest: 0.04, close: 1.15, r: 0.42, z: 0, spin: 0.05 },
      { n: 12, w: 0.38, h: 1.62, cup: 0.38, rest: 0.20, close: 1.02, r: 0.30, z: 0.3, spin: -0.07 },
      { n: 10, w: 0.17, h: 1.14, cup: 0.26, rest: 0.38, close: 0.92, r: 0.18, z: 0.56, spin: 0.1 },
    ];

    for (const spec of RING_SPEC) {
      const geo = petalGeo(spec.w, spec.h, spec.cup);
      const group = new THREE.Group();
      const pivots: THREE_NS.Group[] = [];

      for (let i = 0; i < spec.n; i++) {
        const t = i / (spec.n - 1);

        const mat = new THREE.MeshPhysicalMaterial({
          color: rampAt(t),
          roughness: 0.34,
          metalness: 0.12,
          clearcoat: 0.85,
          clearcoatRoughness: 0.28,
          // A whisper of self-illumination. The petals must not go black when
          // they rotate away from both practicals — a dead petal in a rotating
          // ring reads as a rendering fault, not as shadow.
          emissive: rampAt(t).multiplyScalar(0.16),
          side: THREE.DoubleSide,
        });

        // The pivot spaces the petal around the rosette; the petal tilts out of
        // the plane inside it. Two nested transforms, so opening the bloom never
        // disturbs the spacing.
        const pivot = new THREE.Group();
        pivot.rotation.z = (i / spec.n) * Math.PI * 2;

        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.y = spec.r; // outward along the pivot's own axis
        mesh.position.z = spec.z; // ring depth
        pivot.add(mesh);
        group.add(pivot);
        pivots.push(pivot);
      }

      bloom.add(group);
      rings.push({ group, rest: spec.rest, close: spec.close, spin: spec.spin, pivots });
    }

    /* ---- The shutter at the core ---------------------------------------
       The mark has a real camera aperture at the base of the lotus, and this
       rebuilds that shape in three dimensions rather than approximating it:
       six blades, a straight-edged hexagonal opening, seams that sweep one way,
       and a colour run from violet through magenta to coral.

       HOW IT IS BUILT. The six blades TILE the disc — they do not overlap and
       they are not pie wedges. Blade k is bounded by one edge of the central
       hexagon (V0 to V1), by the outer circle (W1 back to W0), and by two
       identical curves joining the two. The rim points are offset from the
       hexagon vertices by TWIST, so those joining curves bow, and that bow is
       the whole difference between an iris and a pie chart. Adjacent blades
       share each curve exactly, so the seams fall where the flat mark draws its
       highlight lines. */
    const SHUTTER_N = 6;

    /* SIZE IS TAKEN FROM THE ARTWORK, NOT CHOSEN.
       Measured off logo-mark-512.png: the aperture is 60px across in a lotus
       505px wide, so it occupies 0.119 of the mark's width. Deriving it from
       the outer ring here means the shutter keeps that proportion even if the
       petals are ever resized.

       It was 0.95 — 37% of the flower, three times the mark — because it had
       been enlarged twice while chasing a bug that turned out to be face
       culling, not size. Once the blades actually rendered, the enlargement was
       just wrong: this aperture is a small jewel at the heart of the flower,
       not a lens cap over it. */
    const FLOWER_R = RING_SPEC[0].r + RING_SPEC[0].h; // outer petal tip
    const R_OUT = FLOWER_R * 0.119; // outer circle — the mark's own ratio
    // Note: the shutter sits ~0.9 forward of the petals, so perspective renders
    // it about 8% larger than that flat ratio. Left as is — the aperture is the
    // smallest element in the scene and the margin keeps the hexagon readable.
    const C_HEX = R_OUT * 0.46; // hexagon circumradius — this IS the opening
    const TWIST = 0.62; // radians the rim leads the hexagon by

    /* Sampled off the mark's own aperture, running round the ring: magenta at
       the top, violet down the left, rose and coral up the right. Not taken
       from the petal RAMP — the aperture in the artwork is its own narrower
       sweep, and borrowing the petals' orange-to-ocean range would have made
       the core read as a seventh ring of petals rather than as a lens. */
    const SHUTTER_COLS = ['#C94F92', '#A855C8', '#9B52C4', '#B94FA0', '#D2497E', '#DD5B4F'].map(
      (h) => new THREE.Color(h)
    );

    const shutter = new THREE.Group();
    const polar = (a: number, r: number): [number, number] => [Math.cos(a) * r, Math.sin(a) * r];

    for (let k = 0; k < SHUTTER_N; k++) {
      const A0 = Math.PI / 2 + (k * 2 * Math.PI) / SHUTTER_N;
      const A1 = Math.PI / 2 + ((k + 1) * 2 * Math.PI) / SHUTTER_N;

      const [v0x, v0y] = polar(A0, C_HEX);
      const [v1x, v1y] = polar(A1, C_HEX);
      const [w0x, w0y] = polar(A0 + TWIST, R_OUT);
      const [w1x, w1y] = polar(A1 + TWIST, R_OUT);

      // Seam control point: only part of the way round in angle, but most of
      // the way out in radius. Straight seams would turn each blade into a
      // wedge and lose the sweep entirely.
      const seam = (a: number) => polar(a + TWIST * 0.3, C_HEX + (R_OUT - C_HEX) * 0.62);
      const [c1x, c1y] = seam(A1);
      const [c0x, c0y] = seam(A0);

      /* Wound counter-clockwise (signed area of V0-W0-W1-V1 is positive), which
         is the conventional direction to author a contour in. See the material
         below for why that alone was not enough. */
      const shape = new THREE.Shape();
      shape.moveTo(v0x, v0y);
      shape.quadraticCurveTo(c0x, c0y, w0x, w0y); // out to the rim
      shape.absarc(0, 0, R_OUT, A0 + TWIST, A1 + TWIST, false); // along the rim
      shape.quadraticCurveTo(c1x, c1y, v1x, v1y); // back in
      shape.lineTo(v0x, v0y); // the straight hexagon edge closes it

      const geo = new THREE.ExtrudeGeometry(shape, {
        depth: 0.05,
        bevelEnabled: true,
        bevelThickness: 0.018,
        bevelSize: 0.014,
        bevelSegments: 2,
        curveSegments: 16,
      });

      shutter.add(
        new THREE.Mesh(
          geo,
          /* `side: DoubleSide` is the load-bearing line, and it took a while to
             find. The blades were the right shape, the right size, in the right
             place, with correct +Z normals and a lit material — and rendered as
             a black hole in the middle of the flower. The caps of this
             extrusion come out with their triangle winding opposed to their
             normals, so with the default FrontSide the front cap was being
             back-face culled: what reached the screen was the INSIDE of the
             back cap, whose normal points away from every light in the scene.
             Swapping in an unlit DoubleSide material was what finally showed
             it, because that test changed two things at once and the second one
             was the answer. Six small meshes, so the lost culling costs nothing.

             metalness is also kept low: a metal reflects its environment and
             this scene has no environment map, so metal has nothing to reflect
             and darkens for no gain. Clearcoat supplies the lacquered sheen
             that metalness was being asked for. */
          new THREE.MeshPhysicalMaterial({
            color: SHUTTER_COLS[k],
            roughness: 0.34,
            metalness: 0.05,
            clearcoat: 1,
            clearcoatRoughness: 0.16,
            emissive: SHUTTER_COLS[k].clone().multiplyScalar(0.34),
            side: THREE.DoubleSide,
          })
        )
      );
    }

    /* The opening has to read as a HOLE. Left open it becomes a window onto the
       petals passing behind, which is not what the mark draws and not what a
       lens does. A disc just wide enough to circumscribe the hexagon, sat
       behind the blades, closes it — unlit, so no light source can lift it. */
    const pupil = new THREE.Mesh(
      new THREE.CircleGeometry(C_HEX * 1.06, 32),
      new THREE.MeshBasicMaterial({ color: 0x140f26 })
    );
    pupil.position.z = -0.07;
    shutter.add(pupil);

    /* Just clear of the petals, not floating in front of them. The innermost
       ring reaches z 0.78 at full bloom, so 0.9 puts the aperture in front of
       everything by a small margin and lets it sit IN the flower's heart — the
       way the mark nestles it among the petal bases. At 1.45, which is where it
       sat while it was three times too large, a jewel this size read as a
       separate object hovering over the bloom. */
    shutter.position.z = 0.9;
    bloom.add(shutter);

    /* Nearly head-on. The rosette lives in the picture plane, so the tilt only
       needs to be enough to reveal that the petals are solids with thickness —
       any more and the ring foreshortens into an ellipse and loses the mark's
       silhouette. */
    const PITCH = -0.14;
    bloom.rotation.x = PITCH;
    scene.add(bloom);

    /* ---- Light ---------------------------------------------------------
       Two practicals, matching the CSS: tungsten key upper-right, daylight fill
       lower-left. Plus a magenta kicker directly behind the core to separate the
       petal edges from the near-black ground. */
    const key = new THREE.DirectionalLight(0xf2a65a, 3.1);
    key.position.set(4.2, 4.6, 3.4);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x6e9bd1, 1.5);
    fill.position.set(-4.4, -2.6, 2.2);
    scene.add(fill);

    const kick = new THREE.PointLight(0x9b2fc0, 26, 14, 2);
    kick.position.set(0, 0.2, -2.4);
    scene.add(kick);

    scene.add(new THREE.AmbientLight(0x2b2255, 1.4));

    /* ---- Sizing --------------------------------------------------------
       DPR capped at 1.75. Beyond that the pixels are free of charge to the eye
       and expensive to the GPU. */
    /* Where the flower sits, as a fraction of the LAYOUT COLUMN — 0 = the left
       edge of the hero's content box, 1 = its right edge.

       Measured against the content box, never the canvas. The canvas is
       full-bleed, so on a wide monitor a viewport-relative 0.82 threw the
       flower out to the screen edge while the copy stayed in its centred
       container: the two halves of the composition drifted apart and the hero
       read as pushed right with a dead area on the left. Anchoring to the same
       box the copy lives in keeps them locked together at every width. */
    const FRAME_X = 0.82;
    const anchor = document.querySelector('[data-bloom-anchor]');
    let offsetX = 0;

    const resize = () => {
      const r = gl.getBoundingClientRect();
      if (!r.width || !r.height) return;
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
      renderer.setSize(r.width, r.height, false);

      // Resolve FRAME_X against the content box, then express that point as a
      // fraction of the canvas so the camera can be told where to look.
      const b = anchor?.getBoundingClientRect();
      const targetX = b && b.width ? b.left + b.width * FRAME_X : r.left + r.width * FRAME_X;
      const frac = (targetX - r.left) / r.width;

      // Convert to world units at the flower's depth. Recomputed on every
      // resize because the visible world width depends on the aspect — a fixed
      // world offset would drift across the frame as the window changes shape.
      const worldH = 2 * camera.position.z * Math.tan((camera.fov * Math.PI) / 360);
      offsetX = (frac - 0.5) * worldH * camera.aspect;
    };
    resize();
    addEventListener('resize', resize, { passive: true });

    /* ---- Input ---------------------------------------------------------
       Pointer parallax and scroll recession, both damped. Raw pointer values
       drive a rig like a nervous tic; the lerp is what makes it read as a
       camera on a fluid head. */
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    addEventListener(
      'pointermove',
      (e) => {
        pointer.tx = (e.clientX / innerWidth) * 2 - 1;
        pointer.ty = (e.clientY / innerHeight) * 2 - 1;
      },
      { passive: true }
    );

    let scrolled = 0;
    const onScroll = () => {
      scrolled = Math.min(scrollY / Math.max(innerHeight * 0.9, 1), 1);
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    /* ---- Loop ----------------------------------------------------------- */

    const clock = new THREE.Clock();
    let open = 0; // 0 = bud, 1 = full bloom
    let frame = 0; // the live rAF id, and the ONLY record of whether we loop

    /* Only render while the hero is on screen.
       `frame` is the single source of truth for "is a loop running", and start()
       is idempotent. It has to be: the observer fires on its own as soon as it
       is registered, and boot() also wants a loop once the first frame is up.
       Both used to call requestAnimationFrame unconditionally, so TWO loops ran
       over the same scene, each overwriting the other's id — which meant double
       the GPU work, and a cancel that stopped one loop while the other carried
       on rendering off-screen forever. */
    const start = () => {
      if (frame) return;
      clock.getDelta(); // discard the paused interval
      frame = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (!frame) return;
      cancelAnimationFrame(frame);
      frame = 0;
    };

    const io = new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), {
      threshold: 0,
    });
    io.observe(gl);

    function tick() {
      frame = requestAnimationFrame(tick);
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      // Bloom in once, then hold. Cubic ease-out.
      open = Math.min(open + dt * 0.62, 1);
      const eased = 1 - Math.pow(1 - open, 3);

      // Scroll closes it slightly and pushes it back, so it yields to the
      // content coming up rather than competing with it.
      const recede = scrolled;

      rings.forEach((r, i) => {
        // Rings counter-rotate in the rosette plane, like iris blades.
        r.group.rotation.z += r.spin * dt;

        // Each ring breathes on its own phase — a rigidly synchronised flower
        // reads as machinery.
        const breathe = Math.sin(t * 0.42 + i * 1.1) * 0.045;
        const pitch =
          r.close + (r.rest - r.close) * eased * (1 - recede * 0.34) + breathe * eased;

        r.pivots.forEach((p) => {
          (p.children[0] as THREE_NS.Mesh).rotation.x = pitch;
        });
      });

      // Turns against the petals, as a real iris does against its housing, and
      // breathes a little so it never reads as a decal stuck on the front.
      shutter.rotation.z -= dt * 0.2;
      shutter.scale.setScalar(eased * (1 + Math.sin(t * 0.8) * 0.03));

      // Damped parallax. The rig moves a long way less than the pointer does.
      pointer.x += (pointer.tx - pointer.x) * Math.min(dt * 2.4, 1);
      pointer.y += (pointer.ty - pointer.y) * Math.min(dt * 2.4, 1);

      bloom.rotation.y = pointer.x * 0.26;
      bloom.rotation.x = PITCH + pointer.y * 0.14 - recede * 0.2;
      bloom.position.x = offsetX + pointer.x * 0.18;
      bloom.position.y = -pointer.y * 0.12 - recede * 0.5;
      bloom.position.z = -recede * 3.4;

      // Fade out over the first screen rather than letting it collide with the
      // trust bar.
      const vis = 1 - Math.min(recede * 1.25, 1);
      gl.style.opacity = String(vis * 0.96);

      renderer.render(scene, camera);
    }

    // Reveal the canvas over the static fallback only once there is a real
    // frame behind it — otherwise the fallback flashes out to nothing.
    // Composed before the first render, so the flower never appears centred for
    // a frame and then jumps right.
    bloom.position.x = offsetX;
    renderer.render(scene, camera);
    gl.classList.add('is-live');
    start();

    // A lost context must not leave a frozen canvas sitting over the fallback.
    gl.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      stop();
      gl.classList.remove('is-live');
    });
  }
</script>

<style>
  .bloom {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    /* Behind the hero copy, above the page ground. */
    z-index: 0;
  }

  /* On a phone the hero copy runs the full width of the frame, so the bloom is
     no longer beside the text — it is directly behind it, and at full strength
     the bright petals were passing under the paragraph and taking the lead copy
     with them. There is no room to move it, so it drops to ambient instead.
     Wide screens keep it at full strength, where it sits clear of the column. */
  @media (max-width: 760px) {
    .bloom { opacity: 0.32; }
  }

  /* --- Static fallback ----------------------------------------------------
     What most phone visitors see, and it has to be finished in its own right.
     Three concentric conic rings, masked to thin bands: an aperture read from
     the front. Under 1KB of CSS and no JavaScript at all. */
  .bloom__static {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(120vw, 940px);
    aspect-ratio: 1;
    translate: -50% -50%;
    opacity: 0.5;
    transition: opacity 0.9s var(--ease);
  }

  .bloom__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0.5turn,
      #e8532a,
      #f0863c,
      #c4485f,
      #9b2fc0,

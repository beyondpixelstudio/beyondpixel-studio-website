---
/**
 * Video testimonials — poster cards that open the reel in a lightbox.
 *
 * WHY THESE OPEN ON INSTAGRAM RATHER THAN PLAYING HERE.
 *
 * Two versions were tried and measured. Swapping the poster for the iframe in
 * place put the video in a letterboxed strip with dead space under it. Moving
 * it into a lightbox sized for the embed did not help either, and that is the
 * finding: Instagram's /embed/ renders a 9:16 reel inside a landscape media box
 * and pads the remainder white. It is their layout, in a cross-origin iframe,
 * so no CSS on this side can reach it — verified by leaving it six seconds and
 * watching it not change.
 *
 * So the card links out instead. The poster, the play affordance and the name
 * are ours and look right; the video plays where it was published. This also
 * means the page loads NO Instagram JavaScript and sets no Instagram cookies
 * at all, which the embed did.
 *
 * REPLACE THIS WITH SELF-HOSTED VIDEO when the original files are to hand. The
 * studio shot them, so the files exist; served as MP4 they play inline at the
 * right shape, with no third party involved and no white box. The embed HTML
 * does not expose a video URL, so they have to come from Rajesh.
 *
 */
import { testimonials } from '../data/testimonials.ts';
if (testimonials.length === 0) return null;
---

<section class="section tst" id="testimonials">
  <div class="wrap">
    <div class="sechead">
      <p class="eyebrow">On camera</p>
      <h2>Clients, in their own words.</h2>
      <p>
        Filmed on the day and published to our Instagram. Tap any of them to watch
        the full clip.
      </p>
    </div>

    <ul class="tst__list">
      {
        testimonials.map((t, i) => (
          <li class="tst__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <a
              class="tst__card"
              href={`https://www.instagram.com/reel/${t.code}/`}
              target="_blank"
              rel="noopener"
              aria-label={`Watch video on Instagram: ${t.name}, ${t.role}`}
            >
              <span class="tst__frame">
                <img src={t.poster} alt={t.alt} width="760" height="1352" loading="lazy" decoding="async" />
                <span class="tst__veil" aria-hidden="true" />
                {/* Signals that this leaves the site. The card is a link to
                    Instagram, and a bare play triangle promises playback here. */}
                <span class="tst__src" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" focusable="false">
                    <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.5.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.4 1-.9 1.4-.4.5-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.4-1.4-.9-.5-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.4-1 .9-1.4.4-.5.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 5.1a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.8a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0Z" />
                  </svg>
                </span>
                <span class="tst__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
                    <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                  </svg>
                </span>
              </span>
              <span class="tst__who">
                <span class="tst__name">{t.name}</span>
                <span class="tst__role">{t.role}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tst__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--s-4);
    /* A MAXIMUM, not `1fr`. `minmax(180px, 1fr)` let every column stretch to
       fill whatever width was going, so four 9:16 cards grew to ~270x480 and
       the section read as a video wall. Capping the track stops the stretch and
       `justify-content: center` puts the row back in the middle of the space it
       no longer fills. Still auto-fit, so narrow screens drop columns. */
    /* PHONE IS EXPLICITLY TWO, not whatever auto-fit decides.

       `auto-fit` with `minmax(140px, 188px)` was collapsing to a single 188px
       track at 375px — arithmetically two should have fitted, but auto-fit
       resolves against the track sizing function rather than the intent, and
       the result was four reels stacked one above the other down a phone
       screen. Two is a deliberate layout decision for a 9:16 card, so it is
       written down rather than inferred. */
    grid-template-columns: repeat(2, 1fr);
    justify-content: center;
  }

  /* THE CAPTION IS OUTSIDE THE PICTURE NOW, and that is a bug fix before it is
     a style choice. These posters carry the client's name BURNT INTO the frame
     — the cover cards are cut for Instagram, where there is no space for a
     caption underneath. Laying our own label over the bottom of the image
     printed the same name twice, a few pixels apart, in two different fonts:
     "Review- Director, APS-Aska" behind "Director / Aryan Public School".
     No amount of scrim fixes that; the text had to come off the picture. */
  /* From 640 up, hand it back to auto-fit with a MAXIMUM track — that is what
     stops four cards stretching to 270px wide on a desktop. Below it, the
     explicit two-column rule wins. */
  @media (min-width: 640px) {
    .tst__list { grid-template-columns: repeat(auto-fit, minmax(140px, 188px)); }
  }

  .tst__card {
    display: grid; grid-template-rows: auto auto; gap: var(--s-3);
    text-decoration: none; color: inherit;
  }

  .tst__frame {
    position: relative; display: block; overflow: clip;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    background: var(--void);
    /* Two rings, not a border: a hairline of light on the outside and a darker
       one inside. It is what stops a bright poster looking pasted onto the page
       instead of sitting in it. */
    box-shadow:
      0 0 0 1px rgb(255 255 255 / .09),
      inset 0 0 0 1px rgb(0 0 0 / .35),
      0 14px 34px -18px rgb(0 0 0 / .9);
    transition:
      transform var(--t-slow) var(--ease),
      box-shadow var(--t-slow) var(--ease);
  }

  .tst__card img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 700ms var(--ease), filter var(--t-slow) var(--ease);
  }

  /* Held back deliberately. With the caption gone there is no text to protect,
     so this exists only to seat the play control on posters that are bright in
     the middle — a vignette, not a curtain. */
  .tst__veil {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(circle at 50% 44%, rgb(5 4 11 / .34), transparent 58%),
      linear-gradient(to top, rgb(5 4 11 / .34), transparent 42%);
    transition: opacity var(--t-slow) var(--ease);
  }

  /* GLASS, NOT A SOLID DISC. A filled Ember circle sat on the frame as an
     opaque plastic button and — being the most saturated thing in the section —
     pulled the eye off four faces onto four identical blobs. Frosting it lets
     the poster read through, so the control belongs to the image instead of
     covering it. Ember arrives on hover, where it means "this one". */
  .tst__play {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 50px; height: 50px; border-radius: 50%;
    display: grid; place-items: center;
    color: #fff;
    background: rgb(255 255 255 / .14);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / .4),
      0 8px 24px -8px rgb(0 0 0 / .8);
    transition:
      transform var(--t-slow) var(--ease),
      background var(--t-slow) var(--ease),
      box-shadow var(--t-slow) var(--ease);
  }
  .tst__play svg { margin-left: 2px; } /* optical centring of a triangle */

  /* Which platform this opens, stated rather than assumed. */
  .tst__src {
    position: absolute; top: 10px; right: 10px;
    width: 26px; height: 26px; border-radius: 50%;
    display: grid; place-items: center;
    color: rgb(255 255 255 / .92);
    background: rgb(5 4 11 / .42);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .22);
  }

  /* --- Hover: one gesture, the whole card responds ---------------------- */
  .tst__card:hover .tst__frame,
  .tst__card:focus-visible .tst__frame {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ember-text) 45%, transparent),
      inset 0 0 0 1px rgb(0 0 0 / .35),
      0 22px 44px -20px rgb(0 0 0 / .95),
      0 0 34px -12px color-mix(in srgb, var(--ember) 55%, transparent);
  }
  .tst__card:hover img { transform: scale(1.055); }
  .tst__card:hover .tst__veil { opacity: .72; }
  .tst__card:hover .tst__play {
    transform: translate(-50%, -50%) scale(1.09);
    background: color-mix(in srgb, var(--ember) 86%, transparent);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / .5),
      0 10px 30px -8px rgb(0 0 0 / .85);
  }
  .tst__card:focus-visible { outline: none; }
  .tst__card:focus-visible .tst__frame { outline: 2px solid var(--ember-text); outline-offset: 3px; }

  /* --- Caption ---------------------------------------------------------- */
  .tst__who { display: grid; gap: 3px; }
  .tst__name {
    font-size: 13.5px; font-weight: 600; line-height: 1.3; color: var(--text);
    transition: color var(--t-slow) var(--ease);
  }
  .tst__role {
    font-family: var(--font-mono); font-size: 11px; line-height: 1.35;
    color: var(--text-dim);
  }
  .tst__card:hover .tst__name { color: var(--ember-text); }

  @media (prefers-reduced-motion: reduce) {
    .tst__card:hover .tst__frame,
    .tst__card:hover img,
    .tst__card:hover .tst__play { transform: none; }
  }
</style>

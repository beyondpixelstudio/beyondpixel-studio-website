---
/**
 * Client wall — three rows, alternating direction, liquid glass tiles.
 *
 * Rows run left, right, left. The counter-direction is what makes the block
 * read as a field rather than as a conveyor belt, and three rows of a few marks
 * each beats one long row: fewer tiles are on screen at once, so each is
 * readable, and the eye gets variety without the strip getting taller.
 *
 * THE LOGOS ARE TRANSPARENT NOW, which is what makes glass possible at all. A
 * frosted tile is pointless behind a logo that carries its own opaque white
 * rectangle — the white box would sit on top of the blur and cancel it. The
 * poster's white ground is keyed to alpha in the build step, with partial alpha
 * across the anti-aliased rim so no mark picks up a hard fringe.
 *
 * The glass stays LIGHT rather than dark. These are corporate wordmarks drawn
 * for white paper; on a dark tile the darker marks (SOA, Oxford, Sankalp,
 * Reliance) fall to near-invisible. A light frosted tile keeps every one of
 * them readable, which is the only job this section has.
 *
 * SEAMLESS LOOP: each row holds its subset FOUR times and translates by exactly
 * -25%. When the animation restarts, copy 2 is sitting precisely where copy 1
 * began. Four copies rather than two so the row is wider than any viewport plus
 * one copy — otherwise the right-hand end runs out of tiles mid-pass.
 *
 * ACCESSIBILITY: only the first copy of each row carries alt text; the rest are
 * aria-hidden, so a screen reader hears each client once. Pauses on hover and
 * on focus-within (WCAG 2.2 SC 2.2.2). Under prefers-reduced-motion the
 * animation is dropped and each row becomes an ordinary scrollable strip.
 */
import { clients } from '../data/clients.ts';

interface Props {
  /** Seconds for one full pass of the first row. */
  duration?: number;
}
const { duration = 42 } = Astro.props;

/* Split across three rows so each carries about eight marks. */
const per = Math.ceil(clients.length / 3);
const rows = [
  { items: clients.slice(0, per), dir: 'l', dur: duration },
  { items: clients.slice(per, per * 2), dir: 'r', dur: Math.round(duration * 1.22) },
  { items: clients.slice(per * 2), dir: 'l', dur: Math.round(duration * 1.44) },
];

const COPIES = [0, 1, 2, 3];
---

<div class="wall">
  {rows.map((row, ri) => (
    <div
      class:list={['wall__row', `wall__row--${row.dir}`]}
      style={`--dur:${row.dur}s`}
    >
      {COPIES.map((copy) => (
        <ul class="wall__set" aria-hidden={copy === 0 ? undefined : 'true'}>
          {row.items.map((c) => (
            <li class="wall__item">
              <img
                src={`/clients/${c.logo}.webp`}
                alt={copy === 0 ? c.name : ''}
                width="240"
                height="120"
                {/* NOT lazy. A marquee moves tiles into view continuously and
                    the lazy threshold measures against the viewport, so a tile
                    is only requested as it arrives — and scrolls in blank.
                    Many elements, but only 23 unique files; the copies all hit
                    cache and fetchpriority keeps them behind the hero. */}
                loading="eager"
                fetchpriority="low"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</div>

<style>
  .wall {
    position: relative;
    display: grid;
    gap: 7px;
    /* Tiles arrive and leave rather than being chopped off by a hard edge. */
    -webkit-mask: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
    mask: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
  }

  .wall__row { display: flex; width: max-content; }
  .wall__row--l { animation: runL var(--dur) linear infinite; }
  .wall__row--r { animation: runR var(--dur) linear infinite; }

  .wall:hover .wall__row,
  .wall:focus-within .wall__row { animation-play-state: paused; }

  /* -25%, matching the four copies. */
  @keyframes runL { from { transform: translateX(0); }    to { transform: translateX(-25%); } }
  @keyframes runR { from { transform: translateX(-25%); } to { transform: translateX(0); } }

  .wall__set {
    display: flex; align-items: center;
    list-style: none; margin: 0; padding: 0;
    gap: 7px;
    padding-inline: 3.5px;
  }

  /* --- Liquid glass ------------------------------------------------------
     Four layers, and all four are needed for it to read as glass rather than
     as a translucent rectangle:
       1. a tinted, semi-transparent body, so the page shows through;
       2. `backdrop-filter` blurring and saturating what is behind it — this is
          the refraction, and it is the layer that actually says "glass";
       3. a bright specular hairline along the top inner edge plus a full inner
          ring, which gives the pane a lit edge;
       4. a soft drop shadow so it floats rather than being inlaid. */
  .wall__item {
    flex: none;
    width: 96px; height: 58px;
    padding: 8px;
    position: relative;
    border-radius: 13px;
    /* DARK glass, not white. A white pane is the Apple-on-light treatment; on a
       near-black cinematic ground ninety of them become the brightest thing on
       the page and the section stops belonging to the site. The pane is now a
       low-alpha white *tint* over the dark ground — the page shows through, and
       the glass reads from the lit edge and specular instead of from a white
       fill. */
    background: linear-gradient(
      160deg,
      rgb(255 255 255 / .085) 0%,
      rgb(255 255 255 / .05) 45%,
      rgb(255 255 255 / .03) 100%
    );
    /* NO backdrop-filter here, and that is a performance decision rather than a
       stylistic one. There are ninety-odd tiles, and behind them the tunnel is
       rotating and the bubbles are drifting — so every one of those blur regions
       would be invalidated on every frame of a continuously animating backdrop.
       Ninety live blurs is a frame budget, not an effect.

       It costs almost nothing visually: the backdrop here is a soft, near-uniform
       gradient, and blurring a gradient looks like the gradient. The glass still
       reads, from the translucent body, the specular and the lit edge — which is
       where most of it was coming from anyway. The header pill keeps its blur:
       that is ONE element, and it genuinely blurs sharp content scrolling under
       it, which is a case where the effect is visible and worth paying for. */
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / .22),
      inset 0 0 0 1px rgb(255 255 255 / .09),
      0 2px 12px rgb(0 0 0 / .45);
    transition: transform var(--t-slow) var(--ease), box-shadow var(--t-slow) var(--ease),
                background var(--t-slow) var(--ease);
  }

  /* The specular is STATIC — it must not read --mx/--my.
     It did, and that was the flicker: every pointer move changed a custom
     property that this gradient depends on, which invalidated all ninety-odd
     tiles at once, and each of those carries a backdrop-filter. Ninety blur
     regions recomputed per mouse move is not something a compositor can hide.
     A fixed highlight costs nothing and reads the same while the row moves. */
  .wall__item::before {
    content: '';
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      60% 100% at 42% 10%,
      rgb(255 255 255 / .16),
      rgb(255 255 255 / 0) 68%
    );
    opacity: .9;
    transition: opacity var(--t-slow) var(--ease);
  }

  /* A single highlight travelling across on hover. */
  .wall__item::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / .28) 50%, transparent 62%);
    z-index: 2; /* the sweep crosses over the logo, as a reflection would */
    translate: -130% 0;
    opacity: 0;
    transition: translate 700ms var(--ease), opacity 180ms var(--ease);
  }

  .wall__item:hover {
    transform: translateY(-4px) scale(1.07);
    background: linear-gradient(160deg, rgb(255 255 255 / .16), rgb(255 255 255 / .07));
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / .38),
      inset 0 0 0 1px rgb(255 255 255 / .16),
      0 10px 28px rgb(0 0 0 / .55),
      0 0 0 1px rgb(199 67 30 / .45),
      0 6px 26px rgb(199 67 30 / .30);
  }
  .wall__item:hover::before { opacity: 1; }
  .wall__item:hover::after { translate: 130% 0; opacity: 1; }

  /* Fixed box + contain: the marks are mixed aspect ratios, and letting them
     size themselves lets the taller ones overflow and clip.

     `position: relative` is load-bearing. The specular is an absolutely
     positioned ::before, which paints in the positioned layer — ABOVE a static
     child — so it was sitting on top of every logo and washing them out.
     Giving the image its own stacking position puts it back in front of the
     specular and behind the hover sweep. */
  /* The marks are full-colour logos drawn for white paper. On a dark pane they
     either vanish or drag their own white boxes in with them, which is what
     forced the tiles white in the first place.

     `brightness(0)` crushes each mark to solid black regardless of its original
     colours, and `invert(1)` flips that to solid white — so twenty-three
     unrelated logos become one consistent set of light marks. This is the
     standard dark-site treatment and it is why the wall can now be dark.

     Colour returns on hover, so the real brand is still one pointer away. */
  .wall__item img {
    position: relative; z-index: 1;
    width: 100%; height: 100%; object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: .68;
    transition: opacity var(--t-slow) var(--ease), filter var(--t-slow) var(--ease);
  }
  .wall__item:hover img { filter: none; opacity: 1; }

  @media (min-width: 700px) {
    .wall { gap: 8px; }
    .wall__item { width: 112px; height: 66px; border-radius: 15px; }
    .wall__set { gap: 8px; padding-inline: 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__row { animation: none; overflow-x: auto; width: 100%; }
    .wall__set[aria-hidden='true'] { display: none; }
    .wall__item:hover { transform: none; }
    .wall__item::after { display: none; }
    .wall__item::before { background: radial-gradient(60% 100% at 50% 12%, rgb(255 255 255 / .16), rgb(255 255 255 / 0) 68%); }
  }
</style>

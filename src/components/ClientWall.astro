---
/**
 * Continuous client marquee.
 *
 * HOW THE LOOP IS SEAMLESS: the track holds the list TWICE and translates by
 * exactly -50%. At the moment the animation restarts, the second copy is
 * sitting precisely where the first began, so there is no jump. Any other
 * distance leaves a visible seam.
 *
 * ACCESSIBILITY:
 *  - the duplicate copy is `aria-hidden` so a screen reader hears 23 clients,
 *    not 46, and the real list keeps its semantics.
 *  - the marquee pauses on hover AND on focus-within, so a keyboard user can
 *    stop it; WCAG 2.2 SC 2.2.2 requires moving content to be pausable.
 *  - under `prefers-reduced-motion` the animation is dropped entirely and the
 *    strip becomes an ordinary horizontally scrollable list.
 *
 * The logos are colour marks on white, so they sit on white chips rather than
 * being knocked out — inverting two dozen multi-coloured logos would wreck
 * most of them, and a white chip is what the studio's own poster does.
 */
import { clients } from '../data/clients.ts';

interface Props {
  /** Seconds for one full pass. Longer list, longer duration. */
  duration?: number;
}
const { duration = 60 } = Astro.props;
---

<div class="wall" style={`--wall-dur:${duration}s`}>
  <div class="wall__track">
    <ul class="wall__set">
      {clients.map((c) => (
        <li class="wall__item">
          <img
            src={`/clients/${c.logo}.webp`}
            alt={c.name}
            width="340"
            height="188"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    {/* The seam copy. Hidden from assistive tech — it is the same 23 clients. */}
    <ul class="wall__set" aria-hidden="true">
      {clients.map((c) => (
        <li class="wall__item">
          <img src={`/clients/${c.logo}.webp`} alt="" width="340" height="188" loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .wall {
    position: relative;
    overflow: hidden;
    /* Fades the strip into the page at both ends so logos enter and leave
       rather than being chopped off by a hard edge. */
    -webkit-mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .wall__track {
    display: flex;
    width: max-content;
    animation: wallRun var(--wall-dur, 60s) linear infinite;
  }
  .wall:hover .wall__track,
  .wall:focus-within .wall__track { animation-play-state: paused; }

  @keyframes wallRun {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .wall__set {
    display: flex; align-items: center;
    list-style: none; margin: 0; padding: 0;
    gap: var(--s-3);
    padding-inline: calc(var(--s-3) / 2);
  }
  .wall__item {
    flex: none;
    width: 158px; height: 92px;
    padding: 7px;
    position: relative;
    border-radius: var(--r-sm);
    /* Glass, not flat white. The logos need a light backing to stay legible,
       but a plain white rectangle on a black page reads as a hole punched in
       it. A vertical sheen plus a warm-tinted lower half gives the chip a
       surface, and the ring keeps its edge from dissolving into the frame. */
    background:
      linear-gradient(180deg, rgb(255 255 255 / .96) 0%, rgb(248 246 250 / .9) 55%, rgb(238 234 244 / .86) 100%);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / .9),
      inset 0 0 0 1px rgb(255 255 255 / .5),
      0 2px 10px rgb(0 0 0 / .35);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    transition:
      transform var(--t-slow) var(--ease),
      box-shadow var(--t-slow) var(--ease);
  }
  /* The sweep. A single highlight travelling across the chip on hover, which is
     what makes glass read as glass rather than as a pale card. */
  .wall__item::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / .75) 50%, transparent 65%);
    translate: -120% 0;
    opacity: 0;
    transition: translate 700ms var(--ease), opacity 200ms var(--ease);
  }
  .wall__item:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / .9),
      inset 0 0 0 1px rgb(255 255 255 / .6),
      0 10px 26px rgb(0 0 0 / .5),
      0 0 0 1px rgb(199 67 30 / .35),
      0 6px 28px rgb(199 67 30 / .28);
  }
  .wall__item:hover::after { translate: 120% 0; opacity: 1; }

  .wall__item img { width: 100%; height: 100%; object-fit: contain; }

  @media (min-width: 700px) {
    .wall__item { width: 190px; height: 108px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall { overflow-x: auto; }
    .wall__track { animation: none; }
    /* The duplicate adds nothing once it is not scrolling past. */
    .wall__set[aria-hidden='true'] { display: none; }
    .wall__item:hover { transform: none; }
    .wall__item::after { display: none; }
  }
</style>

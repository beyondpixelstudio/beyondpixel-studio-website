---
import { business } from '../data/business.ts';
import { services } from '../data/services.ts';
---

<footer class="ftr" id="contact">
  <div class="wrap ftr__in">
    <div class="ftr__col ftr__col--nap">
      <p class="ftr__name">{business.name}</p>
      <p class="ftr__tag mono">{business.tagline}</p>

      {/* The canonical NAP block. Every value comes from business.ts. */}
      <address class="ftr__nap">
        {business.address.display}
        <a class="ftr__link" href={business.phone.href}>{business.phone.display}</a>
        <a class="ftr__link" href={`mailto:${business.email}`}>{business.email}</a>
      </address>
    </div>

    <div class="ftr__col">
      <h2 class="ftr__h">Services</h2>
      <ul>
        {services.map((s) => (
          <li><a class="ftr__link" href={`/${s.slug}/`}>{s.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="ftr__col">
      <h2 class="ftr__h">Elsewhere</h2>
      <ul>
        <li><a class="ftr__link" href={business.social.instagram}>Instagram</a></li>
        <li><a class="ftr__link" href={business.social.facebook}>Facebook</a></li>
        <li><a class="ftr__link" href={business.social.youtube}>YouTube</a></li>
        <li><a class="ftr__link" href={business.social.googleBusiness}>Google Business Profile</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr__base">
    <p class="mono">&copy; {new Date().getFullYear()} {business.name}</p>
    <p class="mono">{business.founder.name} &middot; {business.founder.role}</p>
  </div>
</footer>

<style>
  .ftr { position: relative; z-index: 2; background: var(--surface); padding-block: var(--s-6) var(--s-4); }
  .ftr__in { display: grid; gap: var(--s-5); grid-template-columns: 1fr; }
  .ftr__col--nap { max-width: 34ch; }
  .ftr__name { font-family: var(--font-display); font-stretch: var(--display-width); font-weight: 700; font-size: 21px; }
  .ftr__tag { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--text-muted); margin-block: 4px var(--s-3); }
  .ftr__nap { font-style: normal; color: var(--text-muted); font-size: var(--fs-sm); display: grid; gap: 6px; }
  .ftr__h { font-family: var(--font-display); font-stretch: var(--display-width); font-size: var(--fs-label); font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: var(--text); margin: 0 0 var(--s-2); }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ftr__link { color: var(--ocean-text); text-decoration: none; font-size: var(--fs-sm); }
  .ftr__link:hover { text-decoration: underline; }
  .ftr__base {
    display: flex; flex-wrap: wrap; gap: var(--s-2); justify-content: space-between;
    margin-top: var(--s-5); padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    color: var(--text-muted); font-size: 12px;
  }
  @media (min-width: 760px) { .ftr__in { grid-template-columns: 1.4fr 1fr 1fr; gap: var(--s-4); } }
</style>

---
import { business } from '../data/business.ts';
import { services } from '../data/services.ts';
---

{/* No id="contact" here. It predates the /contact/ page and the homepage's own
    enquiry section, and having both meant two elements shared one id on the
    homepage — invalid, and the anchor resolves to whichever comes first. */}
<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__col ftr__col--nap">
      <p class="ftr__name">{business.name}</p>
      <p class="ftr__tag mono">{business.tagline}</p>

      {/* The canonical NAP block. Every value comes from business.ts, and the
          PRIMARY line only — the alternate lives on /contact/ alone, so the
          number repeated site-wide is unambiguous to anyone scraping it. */}
      <address class="ftr__nap">
        {business.address.display}
        <a class="ftr__link" href={business.phone.href}>{business.phone.display}</a>
        <a class="ftr__link" href={`mailto:${business.email}`}>{business.email}</a>
        <a class="ftr__link" href="/contact/">All contact details</a>
      </address>
    </div>

    <div class="ftr__col">
      <h2 class="ftr__h">Services</h2>
      <ul>
        {services.map((s) => (
          <li><a class="ftr__link" href={`/${s.slug}/`}>{s.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="ftr__col">
      <h2 class="ftr__h">Elsewhere</h2>
      <ul>
        <li><a class="ftr__link" href={business.social.instagram}>Instagram</a></li>
        <li><a class="ftr__link" href={business.social.facebook}>Facebook</a></li>
        <li><a class="ftr__link" href={business.social.youtube}>YouTube</a></li>
        <li><a class="ftr__link" href={business.social.googleBusiness}>Google Business Profile</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr__base">
    <p class="mono">&copy; {new Date().getFullYear()} {business.name}</p>
    <p class="mono">{business.founder.name} &middot; {business.founder.role}</p>
  </div>
</footer>

<style>
  .ftr {
    position: relative; z-index: 2;
    background: var(--surface);
    border-top: 1px solid rgb(255 255 255 / .06);
    padding-block: var(--s-7) var(--s-5);
  }
  .ftr__in { display: grid; gap: var(--s-6); grid-template-columns: 1fr; }
  .ftr__col--nap { max-width: 34ch; }
  .ftr__name { font-family: var(--font-display); font-stretch: var(--display-width); font-weight: 600; font-size: 19px; letter-spacing: -.01em; }
  .ftr__tag { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); margin-block: var(--s-1) var(--s-4); }
  .ftr__nap { font-style: normal; color: var(--text-muted); font-size: var(--fs-sm); display: grid; gap: 2px; }
  .ftr__h { font-family: var(--font-body); font-size: var(--fs-label); font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); margin: 0 0 var(--s-3); }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  /* WCAG 2.2 SC 2.5.8 sets a 24x24 CSS px floor on targets. At 14px these
     links measure 18px tall, which fails — and a footer link is not an
     "inline in a sentence" exception, it is a discrete control in a list.
     Vertical padding does the work and the list gap shrinks to compensate. */
  .ftr__link {
    display: inline-block; padding-block: 6px;
    color: var(--text-muted); text-decoration: none; font-size: var(--fs-sm);
    transition: color var(--t-fast) var(--ease);
  }
  .ftr__link:hover { color: var(--text); }
  .ftr__base {
    display: flex; flex-wrap: wrap; gap: var(--s-3); justify-content: space-between;
    margin-top: var(--s-6); padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / .06);
    color: var(--text-dim); font-size: 12px;
  }
  @media (min-width: 760px) { .ftr__in { grid-template-columns: 1.4fr 1fr 1fr; gap: var(--s-5); } }
</style>

---
/**
 * The tick used by every `.checks` list.
 *
 * A SHAPE, not the character "✓" — a glyph inherits the body font's weight and
 * baseline and ends up sitting low and thin next to bold text. It is also
 * marked aria-hidden: the list item's own words carry the meaning, and a
 * screen reader announcing "check mark" before each of four points is noise.
 */
---
<span class="checks__m" aria-hidden="true">
  <svg viewBox="0 0 16 16" fill="none" focusable="false">
    <path
      d="M2.5 8.4 6 11.9 13.5 4"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

---
/**
 * Polygon tunnel — the site's ambient background motion.
 *
 * Nested nonagons, each a little smaller and a little further rotated than the
 * one outside it, so the stack reads as a twisted corridor receding to a
 * vanishing point. The whole group turns once every four minutes.
 *
 * WHY SVG AND NOT WEBGL: it is sixteen stroked polygons and one CSS rotation.
 * The 3D lotus already justifies a renderer because it is the hero subject and
 * it is gated behind five checks; a background texture cannot justify a second
 * one, and this version runs on every page, at every width, on every device,
 * for a few hundred bytes and no JavaScript at all.
 *
 * The geometry is computed here at BUILD time, so the browser receives plain
 * markup — there is no layout maths on the main thread at runtime.
 *
 * Opacity peaks around a third of the way in rather than at the outer edge:
 * the corridor should look lit from somewhere down its length, and a stack that
 * simply fades outward reads as a flat target instead.
 */
const SIDES = 9;
const RINGS = 16;
const CX = 500;
const CY = 500;

const rings = Array.from({ length: RINGS }, (_, i) => {
  const t = i / (RINGS - 1); // 0 = outermost, 1 = the vanishing point
  const r = 500 * Math.pow(0.82, i);
  const spin = i * 7; // degrees — this is what twists the corridor
  const points = Array.from({ length: SIDES }, (_, k) => {
    const a = ((spin + (k * 360) / SIDES) * Math.PI) / 180;
    return `${(CX + r * Math.cos(a)).toFixed(1)},${(CY + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');

  // Peak brightness at t≈0.35, falling away to both ends.
  const fall = 1 - Math.abs(t - 0.35) / 0.65;
  const alpha = Math.max(0.04, 0.34 * fall);
  // Warm at the mouth, cooler as it recedes — the same two practicals the rest
  // of the page is lit by.
  const hue = t < 0.45 ? 'var(--ember)' : t < 0.75 ? 'var(--magenta)' : 'var(--ocean)';
  return { points, alpha: alpha.toFixed(3), hue, dur: (18 + i * 2.5).toFixed(1) };
});
---

<div class="tunnel" aria-hidden="true">
  <svg viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g class="tunnel__spin">
      {rings.map((r) => (
        <polygon
          class="tunnel__ring"
          points={r.points}
          style={`--a:${r.alpha}; --c:${r.hue}; --d:${r.dur}s`}
        />
      ))}
    </g>
  </svg>
</div>

<style>
  .tunnel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .tunnel svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(190vmax, 2200px);
    height: min(190vmax, 2200px);
    translate: -50% -50%;
    opacity: .5;

    /* EVERY tunnel animation lives on this one element, and that is the whole
       performance story of this component.

       It used to animate the sixteen rings individually and the <g> that holds
       them. Those are SVG CHILDREN, and a transform on an SVG child is not
       compositable — it repaints the parent. The parent here is up to
       2200x2200, so the browser was rasterising a four-megapixel surface every
       frame. Measured: 18.6fps with the tunnel on, 60.5fps with it hidden.

       The <svg> itself is a replaced element in HTML flow, so transforming IT
       promotes one layer, rasterises the corridor once, and moves the finished
       bitmap thereafter.

       Three separate properties are used on purpose — `rotate`, `transform` and
       `scale` compose rather than overwrite, so the spin, the breathe and the
       scroll zoom can run at three different rates without fighting. */
    will-change: transform;
    animation:
      tunnelSpin 240s linear infinite,
      tunnelBreathe 16s ease-in-out infinite alternate;
  }
  @keyframes tunnelSpin {
    to { rotate: 360deg; }
  }
  /* The corridor still breathes; it just breathes as one object now. The sense
     that it is not rigid comes from the geometry — each ring is already twisted
     7 degrees further than the one outside it, and that is baked in at build. */
  @keyframes tunnelBreathe {
    from { transform: scale(1); }
    to   { transform: scale(1.04); }
  }

  .tunnel__ring {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.6;
    opacity: var(--a);
    vector-effect: non-scaling-stroke;
  }

  /* SCROLL ZOOM. The corridor pushes in as the page scrolls, so the background
     has the same depth cue as the content moving over it.

     Driven by a native scroll timeline — no listener, no rAF, no main-thread
     work at all. `scale` is its own property here, so it composes with the
     `translate` that centres the svg instead of fighting it, and browsers
     without scroll timelines simply get the static corridor. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Listed explicitly: setting `animation-name` alone would drop the spin
         and the breathe declared above. */
      .tunnel svg {
        animation-name: tunnelSpin, tunnelBreathe, tunnelZoom;
        animation-duration: 240s, 16s, auto;
        animation-timing-function: linear, ease-in-out, linear;
        animation-iteration-count: infinite, infinite, 1;
        animation-direction: normal, alternate, normal;
        animation-fill-mode: none, none, both;
        animation-timeline: auto, auto, scroll(root block);
      }
      @keyframes tunnelZoom {
        from { scale: 1; }
        to   { scale: 2.1; }
      }
    }
  }



  /* On a wide screen the corridor sits off to the right, behind the hero
     subject, the way the reference frames it. Centred below that, where there
     is no room for it to be anywhere else. */
  @media (min-width: 1100px) {
    .tunnel svg { left: 74%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tunnel svg, .tunnel__spin, .tunnel__ring { animation: none; }
  }
</style>

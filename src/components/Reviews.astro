---
/**
 * Review sources, rendered from business.reviews.
 *
 * A source whose `value` is null renders as a LINK rather than as a rating —
 * the component never fabricates a number to fill the shape. That is the whole
 * reason this is data-driven: when the real Google figure is known it goes in
 * one file and this turns into a second star rating on every page at once.
 */
import { business } from '../data/business.ts';

interface Props {
  /** `hero` sits inline under the CTA; `block` centres itself in a section. */
  variant?: 'hero' | 'block';
}
const { variant = 'hero' } = Astro.props;
---

<ul class:list={['revs', `revs--${variant}`]}>
  {business.reviews.map((r) => (
    <li class="rev">
      {/* Stars ONLY where there is a verified rating behind them. Drawing five
          stars beside the Google link would assert a five-star Google rating
          nobody has checked — the same fabrication as inventing the count, just
          harder to notice. */}
      {r.value !== null && <span class="rev__stars" aria-hidden="true">★★★★★</span>}
      {r.value !== null ? (
        <span class="rev__txt">
          <b>{r.value.toFixed(1)}</b>
          <span class="rev__sep" aria-hidden="true">·</span>
          <span>{r.count} reviews on {r.source}</span>
        </span>
      ) : r.url ? (
        <a class="rev__txt rev__txt--link" href={r.url} rel="noopener">
          Read our {r.source} reviews
          <span class="rev__go" aria-hidden="true">→</span>
        </a>
      ) : null}
    </li>
  ))}
</ul>

<style>
  /* The two sources are SIBLINGS, drawn the same way. The Google entry used to
     be a filled pill with a gradient monogram while JustDial was bare text, and
     side by side that read as one advert bolted onto one fact. Same stars, same
     type, same weight — the only difference is that one carries a number and
     the other carries a link, which is the only difference that is real. */
  .revs {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  .revs--block { justify-content: center; }

  .rev { display: inline-flex; align-items: center; gap: var(--s-2); font-size: 13px; color: var(--text-muted); }
  /* A hairline divider between the two, drawn by the second item so it never
     appears at the start or after a wrap onto its own line. */
  .rev + .rev { padding-left: var(--s-4); border-left: 1px solid rgb(255 255 255 / .1); }

  .rev__stars { color: var(--tungsten); letter-spacing: .1em; font-size: 13px; }
  .rev__txt { display: inline-flex; align-items: center; gap: 6px; }
  .rev b { color: var(--text); font-weight: 600; }
  .rev__sep { color: var(--text-dim); }

  .rev__txt--link {
    color: var(--text-muted); text-decoration: none;
    padding-block: 4px;                 /* clears the 24px target floor */
    transition: color var(--t-fast) var(--ease);
  }
  .rev__txt--link:hover { color: var(--text); }
  .rev__go { color: var(--ember-text); transition: translate var(--t-fast) var(--ease); }
  .rev__txt--link:hover .rev__go { translate: 3px 0; }

  @media (max-width: 520px) {
    .rev + .rev { padding-left: 0; border-left: 0; }
  }
</style>

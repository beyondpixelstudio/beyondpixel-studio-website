---
/**
 * Review sources, rendered from business.reviews.
 *
 * A source whose `value` is null renders as a LINK rather than as a rating —
 * the component never fabricates a number to fill the shape. That is the whole
 * reason this is data-driven: when the real Google figure is known it goes in
 * one file and this turns into a second star rating on every page at once.
 */
import { business } from '../data/business.ts';

interface Props {
  /** `hero` sits inline under the CTA; `block` centres itself in a section. */
  variant?: 'hero' | 'block';
}
const { variant = 'hero' } = Astro.props;
---

<ul class:list={['revs', `revs--${variant}`]}>
  {business.reviews.map((r) => (
    <li class="rev">
      {r.value !== null ? (
        <>
          <span class="rev__stars" aria-hidden="true">★★★★★</span>
          <span class="rev__txt">
            <b>{r.value.toFixed(1)}</b>
            <span class="rev__sep" aria-hidden="true">·</span>
            {r.count} reviews on {r.source}
          </span>
        </>
      ) : r.url ? (
        <a class="rev__link" href={r.url} rel="noopener">
          <span class="rev__g" aria-hidden="true">G</span>
          <span class="rev__txt">Read our {r.source} reviews</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : null}
    </li>
  ))}
</ul>

<style>
  .revs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: center; }
  .revs--block { justify-content: center; }

  .rev { display: flex; align-items: center; gap: var(--s-2); font-size: 13px; color: var(--text-muted); }
  .rev__stars { color: var(--tungsten); letter-spacing: .1em; font-size: 14px; }
  .rev__txt { display: inline-flex; align-items: center; gap: 6px; }
  .rev b { color: var(--text); font-weight: 600; }
  .rev__sep { color: var(--text-dim); }

  .rev__link {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 32px; padding: 4px 12px 4px 4px;
    border-radius: 999px;
    background: var(--raised); box-shadow: var(--edge);
    color: var(--text-muted); text-decoration: none;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .rev__link:hover { background: var(--overlay); color: var(--text); }
  /* Google's own mark cannot be reproduced without permission, so this is a
     neutral monogram chip rather than a fake logo. */
  .rev__g {
    width: 24px; height: 24px; flex: none;
    display: grid; place-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ember-hover), var(--magenta));
    color: #fff; font-weight: 700; font-size: 13px; line-height: 1;
  }
</style>

---
/**
 * FAQ block + FAQPage schema.
 *
 * ONE array in, two outputs: the visible accordion and the JSON-LD. Google drops
 * the rich result when the marked-up answer and the on-page answer disagree, and
 * rendering both from the same source is the only way that never happens through
 * a year of copy edits. The RP Films system learned this the hard way and left a
 * note about it; this enforces it instead of asking people to remember.
 *
 * `<details>` rather than a JS accordion: it is keyboard-operable, findable by
 * the browser's own in-page search, and works with JS off.
 */
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  eyebrow?: string;
  /** Emit schema only where the answers are the page's own subject. */
  schema?: boolean;
}
const { items, heading = 'Questions people actually ask', eyebrow = 'FAQ', schema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

<section class="section faq" id="faq">
  <div class="wrap">
    <div class="sechead">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
    </div>

    <ul class="faq__list">
      {
        items.map((f) => (
          <li>
            <details class="faq__item">
              <summary>
                <span class="faq__q">{f.q}</span>
                <span class="faq__mark" aria-hidden="true" />
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); max-width: 900px; margin-inline: auto; }

  /* Glass is earned here — the tunnel and the bloom move behind these panels. */
  .faq__item {
    background: color-mix(in srgb, var(--raised) 74%, transparent);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: var(--radius);
    transition: border-color var(--t-slow) var(--ease), background var(--t-slow) var(--ease);
  }
  .faq__item[open] { background: color-mix(in srgb, var(--raised) 92%, transparent); border-color: color-mix(in srgb, var(--ember-text) 30%, transparent); }
  .faq__item:hover { border-color: color-mix(in srgb, var(--text) 16%, transparent); }

  summary {
    display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3);
    padding: var(--s-3);
    cursor: pointer;
    list-style: none;
    min-height: 44px; /* WCAG 2.2 target size */
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--ember-text); outline-offset: 2px; border-radius: var(--radius); }

  .faq__q { font-weight: 500; color: var(--text); }

  /* A plus that becomes a cross. Two bars, one rotated — no icon font, no SVG. */
  .faq__mark { position: relative; flex: none; width: 16px; height: 16px; margin-top: 4px; }
  .faq__mark::before, .faq__mark::after {
    content: ''; position: absolute; inset: 50% 0 auto 0;
    height: 1.5px; background: var(--ember-text); border-radius: 2px;
    transition: transform var(--t-slow) var(--ease);
  }
  .faq__mark::after { transform: rotate(90deg); }
  .faq__item[open] .faq__mark::before { transform: rotate(135deg); }
  .faq__item[open] .faq__mark::after { transform: rotate(45deg); }

  /* Fills the panel. The measure was capped at 68ch for readability, but inside
     a 900px panel that left a third of the box empty and the answer read as
     misaligned with its own heading. The panel is the measure now — the list is
     already capped at 900px, so the line length stays reasonable. Size nudged up
     slightly to compensate for the longer line. */
  .faq__a {
    margin: 0; padding: 0 var(--s-3) var(--s-3);
    color: var(--text-muted); font-size: 15px; line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__mark::before, .faq__mark::after, .faq__item { transition: none; }
  }
</style>

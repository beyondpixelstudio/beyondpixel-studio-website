---
/**
 * Service Rig — the 3D object in a service page's hero
 *
 * One component, one canvas, one geometry builder chosen by the `rig` prop.
 * The other five services slot in as further builders in RIGS below; nothing
 * else has to change.
 *
 * -------------------------------------------------------------------------
 * WHY THIS IS BUILT AND NOT DOWNLOADED
 *
 * The obvious move is a GLB off Sketchfab. Three reasons it is not:
 *
 *   LICENCE. CC-BY is the default on Sketchfab's free downloads and the
 *   uploader cannot change it. That means a visible credit to a stranger on a
 *   commercial service page. CC0 exists but is effectively the museum
 *   programme — there is no CC0 mirrorless camera.
 *
 *   WEIGHT. three.js is already 724KB here. A photoreal camera with PBR
 *   textures is 5-30MB more, plus GLTFLoader, and there would be six of them.
 *
 *   CONSISTENCY, which is the one that actually decides it. Six models by six
 *   artists carry six lighting conventions, six scales and six material
 *   vocabularies. They cannot be made to look like one website. Six objects
 *   built against one rig, one light and one palette are one family by
 *   construction.
 *
 * And the part of the brief that was declined: no hand. A hand is an organic
 * mesh — it wants sculpting or a rigged download, and a bad 3D hand is the most
 * off-putting object you can put on a screen. Kit floating in its own light
 * reads as premium; the same kit gripped by a stiff mannequin hand reads as a
 * 2009 stock render.
 *
 * -------------------------------------------------------------------------
 * WHAT MAKES IT READ AS A GIMBAL
 *
 * Not the silhouette — the BEHAVIOUR. A gimbal is defined by the fact that the
 * handle moves and the camera does not. So the handle is swayed as if walked
 * with, and the three motor axes are driven to cancel that sway, each with a
 * deliberate lag. You watch the motors catch up. Remove the lag and it becomes
 * one rigid object rotating; remove the cancellation and it becomes a camera on
 * a stick. The lag IS the effect.
 *
 * -------------------------------------------------------------------------
 * WHAT PROTECTS THE PAGE FROM IT
 *
 * The same five gates as LotusBloom, for the same reasons, and the import is
 * dynamic so a device that fails one downloads none of it:
 *
 *   1. after `load` + idle — never competes with LCP or font swap
 *   2. `prefers-reduced-motion: no-preference`
 *   3. viewport >= 1100px — below that there is no right column and the rig
 *      lands behind the H1
 *   4. WebGL probed, not UA-sniffed
 *   5. `deviceMemory` >= 4 where reported
 *
 * Plus an IntersectionObserver that stops the loop when the hero scrolls away,
 * and a context-loss handler that gives the canvas back to the fallback.
 *
 * The canvas is FULL-BLEED and the subject is composed inside it in world
 * space, via FRAME_X. Insetting the canvas to the right column instead is the
 * obvious move and it is wrong: the canvas edge clips the lens dead straight,
 * which reads as a broken render rather than as a crop.
 * -------------------------------------------------------------------------
 */

interface Props {
  /** Which object to build. Only 'gimbal' exists so far. */
  rig: string;
}

const { rig } = Astro.props;
---

<div class="rig" aria-hidden="true">
  {/* Static stand-in. Painted always; the canvas fades in over it if it earns
      the right to. Hidden below the two-column threshold, where it would sit
      behind the headline rather than beside it. */}
  <div class="rig__static">
    <span class="rig__glow"></span>
    <span class="rig__iris"></span>
  </div>

  <canvas class="rig__gl" data-rig={rig}></canvas>
</div>

<script>
  import type * as THREE_NS from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-rig]');

  /* -- Gates ------------------------------------------------------------- */

  const webglOK = () => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };

  /** The two-column threshold. Declared here and nowhere else — the stylesheet
      keys its layout off `.is-live`, which by construction only appears once
      this gate has passed, so the number never exists in two files. */
  const WIDE = 1100;

  const allowed = () =>
    !!canvas &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
    window.matchMedia(`(min-width: ${WIDE}px)`).matches &&
    ((navigator as any).deviceMemory ?? 8) >= 4 &&
    webglOK();

  const idle = (fn: () => void) =>
    'requestIdleCallback' in window
      ? (window as any).requestIdleCallback(fn, { timeout: 2600 })
      : setTimeout(fn, 900);

  if (allowed()) {
    if (document.readyState === 'complete') idle(() => void boot());
    else window.addEventListener('load', () => idle(() => void boot()), { once: true });
  }

  /* -- Scene ------------------------------------------------------------- */

  async function boot() {
    const THREE = (await import('three')) as typeof THREE_NS;
    const gl = canvas!;

    const scene = new THREE.Scene();

    // A long lens, for the same reason the bloom uses one: wide-angle on a
    // compact hard-surface subject exaggerates the near corners and the object
    // stops reading as a real piece of kit.
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
    camera.position.set(0, 0, 9);

    const renderer = new THREE.WebGLRenderer({
      canvas: gl,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearAlpha(0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.34;

    /* ---- Environment ---------------------------------------------------
       Anodised aluminium and glass are defined by what they REFLECT. Without
       an environment map, metalness has nothing to work with and every metal
       part just goes darker — which is why the bloom keeps its metalness near
       zero and leans on clearcoat instead.

       Here the metal is the point, so the scene gets an environment: a 32x16
       equirectangular gradient painted on a 2D canvas. Warm above, cool below,
       with a tungsten blob upper-right and a daylight blob lower-left — the
       same two practicals as the lights, so reflections and shading agree
       about where the room is. At this resolution it is inherently blurry,
       which is exactly what a softbox looks like in a lens barrel. Costs one
       tiny texture and no extra import. */
    const envC = document.createElement('canvas');
    envC.width = 32;
    envC.height = 16;
    const ectx = envC.getContext('2d')!;
    const grad = ectx.createLinearGradient(0, 0, 0, 16);
    grad.addColorStop(0, '#332c38');
    grad.addColorStop(0.55, '#1a1720');
    grad.addColorStop(1, '#0b0d14');
    ectx.fillStyle = grad;
    ectx.fillRect(0, 0, 32, 16);
    const blob = (x: number, y: number, r: number, c: string) => {
      ectx.fillStyle = c;
      ectx.beginPath();
      ectx.arc(x, y, r, 0, Math.PI * 2);
      ectx.fill();
    };
    /* The tungsten blob is deliberately much stronger than the daylight one.
       Balanced, the two turned the whole body navy: this scene is mostly metal,
       metal is mostly reflection, and an even warm/cool environment averages
       out to the cool one because the cool light also fills the shadow side.
       A camera body is near-black — it must not read as a blue prop. */
    blob(23, 4, 5.4, 'rgba(246,178,108,.98)'); // tungsten key, upper right
    blob(7, 11, 3.6, 'rgba(110,155,209,.34)'); // daylight fill, lower left
    const envTex = new THREE.CanvasTexture(envC);
    envTex.mapping = THREE.EquirectangularReflectionMapping;
    envTex.colorSpace = THREE.SRGBColorSpace;
    scene.environment = envTex;

    /* ---- Shared geometry helpers --------------------------------------- */

    /** A rounded box, from an extruded rounded rectangle with a bevel.
        Camera bodies and gimbal arms have no sharp edges anywhere on them, and
        a plain BoxGeometry catches the key light along a hard line that
        immediately reads as "primitive", not "product". */
    const roundedBox = (w: number, h: number, d: number, r: number) => {
      const bev = Math.min(0.03, d * 0.24);
      const x = w / 2;
      const y = h / 2;
      const s = new THREE.Shape();
      s.moveTo(-x + r, -y);
      s.lineTo(x - r, -y);
      s.quadraticCurveTo(x, -y, x, -y + r);
      s.lineTo(x, y - r);
      s.quadraticCurveTo(x, y, x - r, y);
      s.lineTo(-x + r, y);
      s.quadraticCurveTo(-x, y, -x, y - r);
      s.lineTo(-x, -y + r);
      s.quadraticCurveTo(-x, -y, -x + r, -y);

      const g = new THREE.ExtrudeGeometry(s, {
        depth: Math.max(d - bev * 2, 0.01),
        bevelEnabled: true,
        bevelThickness: bev,
        bevelSize: bev,
        bevelSegments: 2,
        curveSegments: 8,
      });
      g.center();
      return g;
    };

    /** A cylinder lying along an arbitrary axis. CylinderGeometry is built
        along Y, and every barrel, motor and dial in this scene needs a
        different one. */
    const cyl = (r: number, h: number, axis: 'x' | 'y' | 'z', seg = 32) => {
      const g = new THREE.CylinderGeometry(r, r, h, seg);
      if (axis === 'x') g.rotateZ(Math.PI / 2);
      if (axis === 'z') g.rotateX(Math.PI / 2);
      return g;
    };

    /* ---- Materials ------------------------------------------------------
       Five, and every part uses one of them. A camera is not a colourful
       object — it is three greys, one glass and one warning light — and the
       restraint is what stops it looking like a toy. The single saturated
       element is the record tally, in Ember, which is also the only part of
       the object that is supposed to draw the eye. */
    /* THESE ARE NOT THE COLOURS OF A CAMERA, AND THAT IS DELIBERATE.

       A real body is near-black anodised aluminium. Built that way it was
       accurate and invisible: a black object on a near-black page has no
       silhouette, and rim light alone could not carry it — you could see that
       something was there without being able to tell what. Every tone is
       therefore lifted to a graphite the page can actually hold, with the
       violet cast the elevation tokens already carry so it sits in this
       palette rather than reading as a grey cut-out. Legibility beats
       accuracy: the object has to be recognisable at a glance from two metres
       away, which is the only way anyone will ever look at it. */
    const M = {
      body: new THREE.MeshPhysicalMaterial({
        color: 0x433d52,
        roughness: 0.44,
        metalness: 0.36,
        clearcoat: 0.55,
        clearcoatRoughness: 0.38,
        envMapIntensity: 1.1,
      }),
      trim: new THREE.MeshPhysicalMaterial({
        color: 0x5d5670,
        roughness: 0.3,
        metalness: 0.72,
        clearcoat: 0.6,
        clearcoatRoughness: 0.2,
        envMapIntensity: 1.35,
      }),
      motor: new THREE.MeshPhysicalMaterial({
        color: 0x6e6786,
        roughness: 0.24,
        metalness: 0.82,
        clearcoat: 0.7,
        clearcoatRoughness: 0.14,
        envMapIntensity: 1.15,
      }),
      // Textured rubber: the grip and the focus ring. High roughness, no
      // metal, so it stays matte while everything around it catches light.
      grip: new THREE.MeshPhysicalMaterial({
        color: 0x282332,
        roughness: 0.92,
        metalness: 0.02,
        envMapIntensity: 0.4,
      }),
      /* The lens's front element ONLY. Glass is the one surface here allowed
         a coating flare, and even that is kept low: at 0.62 it stopped being a
         reflection and became a lamp, and a camera with a glowing eye reads as
         a prop. Ocean, because a real multi-coating flares blue-green. */
      glass: new THREE.MeshPhysicalMaterial({
        color: 0x04080e,
        roughness: 0.05,
        metalness: 0.12,
        clearcoat: 1,
        clearcoatRoughness: 0.04,
        emissive: 0x1b6ca8,
        emissiveIntensity: 0.1,
        envMapIntensity: 0.75,
      }),
      /* Switched-off screens — the camera's rear LCD and the battery pack's
         panel. They share no material with the lens on purpose: they were
         `glass` at first and lit up the same blue, which put three glowing
         eyes on one object. A dark screen is what an idle screen looks like. */
      screen: new THREE.MeshPhysicalMaterial({
        color: 0x0a0910,
        roughness: 0.12,
        metalness: 0.1,
        clearcoat: 1,
        clearcoatRoughness: 0.06,
        envMapIntensity: 0.55,
      }),
    };

    /** The record tally. Held as its own material because the loop pulses it. */
    const tallyMat = new THREE.MeshPhysicalMaterial({
      color: 0xc7431e,
      emissive: 0xf2704a,
      emissiveIntensity: 1.4,
      roughness: 0.35,
      metalness: 0.1,
    });

    /** The lens's red ring. Ember, and lightly self-lit so it holds its colour
        when that side of the barrel turns away from the key. */
    const ringMat = new THREE.MeshPhysicalMaterial({
      color: 0xc7431e,
      emissive: 0xc7431e,
      emissiveIntensity: 0.38,
      roughness: 0.28,
      metalness: 0.2,
      clearcoat: 1,
      clearcoatRoughness: 0.1,
    });

    /** The lens hood. Its own material only because it is the one open-ended
        tube in the scene and therefore the one thing that needs DoubleSide —
        without it the near wall is culled and you see straight through. */
    const hoodMat = new THREE.MeshPhysicalMaterial({
      color: 0x39334a,
      roughness: 0.66,
      metalness: 0.18,
      side: THREE.DoubleSide,
      envMapIntensity: 0.7,
    });

    const add = (
      parent: THREE_NS.Object3D,
      geo: THREE_NS.BufferGeometry,
      mat: THREE_NS.Material,
      x = 0,
      y = 0,
      z = 0
    ) => {
      const m = new THREE.Mesh(geo, mat);
      m.position.set(x, y, z);
      parent.add(m);
      return m;
    };

    /* ---- The rig -------------------------------------------------------
       Modelled against a real single-handle gimbal — a Weebill-class body
       carrying a full-frame camera and a professional zoom. Working from a
       specific reference rather than from the idea of a gimbal is what puts in
       the parts that make it recognisable and that nobody invents from memory:
       the mini tripod under the grip, the battery pack slung off the side of
       the pan motor, the diagonal sling arm, and the long lens rail the camera
       actually bolts to.

       Hierarchy matters more than dimensions, because it is what makes the
       stabilisation possible:

         root  -> slow presentation turn, pointer parallax, scroll recession
          sway -> the handle's motion, as if being walked with
           pan  (Y) -> motor 1
            roll (Z) -> motor 2
             tilt (X) -> motor 3
              camera  -> body, rail, lens

       Each motor group is a child of the one before, exactly as the real arm
       is assembled, so driving each rotation by the negation of the sway
       cancels it in the right order. Flatten this into siblings and the
       corrections apply in the wrong frames and the camera wobbles anyway.

       The battery pack is the one exception: it hangs off `sway`, not off
       `pan`, because on the real thing it is bolted to the fixed body and does
       NOT spin with the pan motor. Parented to `pan` it swings around the
       handle like a fairground ride. */
    const root = new THREE.Group();
    const sway = new THREE.Group();
    const pan = new THREE.Group();
    const roll = new THREE.Group();
    const tilt = new THREE.Group();
    const cam = new THREE.Group();

    root.add(sway);
    sway.add(pan);
    pan.add(roll);
    roll.add(tilt);
    tilt.add(cam);
    scene.add(root);

    /* --- Mini tripod ----------------------------------------------------
       Three folding legs. The most recognisable thing on the whole object
       after the lens, and the part that says "this is a gimbal" rather than
       "this is a camera on a pole" even in silhouette. Offset by a sixth of a
       turn so a leg points at the viewer instead of a gap. */
    const hub = new THREE.Group();
    hub.position.set(0, -1.86, 0);
    sway.add(hub);
    add(hub, cyl(0.17, 0.2, 'y'), M.trim, 0, 0, 0);
    for (let i = 0; i < 3; i++) {
      const leg = new THREE.Group();
      leg.rotation.y = (i / 3) * Math.PI * 2 + Math.PI / 6;
      // Splayed 0.95rad off vertical; the offsets are the leg's own half-length
      // resolved onto that angle, so the top of each leg meets the hub exactly.
      const shaft = add(leg, roundedBox(0.13, 0.62, 0.16, 0.05), M.body, 0, -0.18, 0.25);
      shaft.rotation.x = -0.95;
      add(leg, roundedBox(0.17, 0.06, 0.21, 0.03), M.grip, 0, -0.36, 0.5); // rubber foot
      hub.add(leg);
    }

    /* --- Handle ---------------------------------------------------------
       Lives on `sway`, NOT on `pan` — it is the part the operator holds, so it
       is the part that must visibly move while the camera does not. */
    add(sway, roundedBox(0.36, 0.98, 0.42, 0.14), M.grip, 0, -1.32, 0);
    add(sway, cyl(0.23, 0.14, 'y', 24), M.trim, 0, -1.72, 0); // knurled collar
    add(sway, roundedBox(0.4, 0.12, 0.46, 0.05), M.trim, 0, -0.86, 0); // top collar
    // Record button and battery lamp, on the face the thumb reaches.
    add(sway, cyl(0.05, 0.03, 'z', 16), tallyMat, 0.09, -1.02, 0.23);
    add(sway, roundedBox(0.12, 0.045, 0.02, 0.015), M.motor, -0.08, -1.02, 0.23);

    /* Battery / monitor pack, slung off the right of the body. */
    add(sway, roundedBox(0.46, 0.48, 0.28, 0.06), M.body, 0.46, -0.52, 0);
    add(sway, roundedBox(0.3, 0.34, 0.02, 0.02), M.screen, 0.7, -0.52, 0);

    /* --- Motor 1: PAN, vertical axis, above the handle ------------------- */
    pan.position.set(0, -0.54, 0);
    add(pan, cyl(0.3, 0.52, 'y'), M.motor, 0, 0, 0);
    add(pan, cyl(0.31, 0.05, 'y'), M.trim, 0, 0.22, 0); // seam ring
    /* The sling arm. Diagonal, not a right angle: this is the line that gives
       the object its lean, and squaring it off makes it read as a lamp. */
    const armA = add(pan, roundedBox(0.18, 0.9, 0.2, 0.06), M.body, -0.28, 0.08, 0);
    armA.rotation.z = 0.68;

    /* --- Motor 2: ROLL, axis along the lens ------------------------------ */
    roll.position.set(-0.55, 0.44, 0);
    add(roll, cyl(0.27, 0.36, 'z'), M.motor, 0, 0, 0.04);
    add(roll, cyl(0.28, 0.05, 'z'), M.trim, 0, 0, 0.23);
    const armB = add(roll, roundedBox(0.17, 0.56, 0.19, 0.055), M.body, -0.13, 0.41, 0);
    armB.rotation.z = 0.55;

    /* --- Motor 3: TILT, axis across the camera --------------------------- */
    tilt.position.set(-0.28, 0.66, 0);
    add(tilt, cyl(0.25, 0.36, 'x'), M.motor, 0, 0, 0);
    add(tilt, cyl(0.26, 0.05, 'x'), M.trim, 0.19, 0, 0);
    add(tilt, roundedBox(0.2, 0.36, 0.32, 0.05), M.body, 0.22, -0.2, 0); // riser
    // The lens rail the camera bolts to, and the quick-release plate on it.
    add(tilt, roundedBox(1.5, 0.11, 0.36, 0.04), M.trim, 0.95, -0.38, 0);
    add(tilt, roundedBox(1.12, 0.07, 0.3, 0.02), M.motor, 1.0, -0.29, 0);

    /* ---- The camera ----------------------------------------------------
       Full-frame body: pentaprism hump on the centre line, deep grip on the
       right, and a professional zoom that is a stack of rings rather than one
       tube. The stack is what sells it — a single cylinder reads as a
       telescope. */
    cam.position.set(1.02, -0.24, 0);

    add(cam, roundedBox(1.05, 0.82, 0.64, 0.09), M.body, 0, 0.45, 0); // body
    add(cam, roundedBox(0.36, 0.24, 0.42, 0.06), M.body, -0.06, 0.97, -0.02); // pentaprism
    add(cam, roundedBox(0.19, 0.06, 0.2, 0.02), M.trim, -0.06, 1.11, -0.02); // hot shoe
    add(cam, roundedBox(0.34, 0.76, 0.6, 0.11), M.grip, 0.6, 0.44, 0.03); // grip
    add(cam, cyl(0.12, 0.08, 'y'), M.trim, 0.34, 0.9, -0.05); // mode dial
    add(cam, cyl(0.1, 0.07, 'y'), M.trim, 0.12, 0.9, 0.14); // top dial
    add(cam, roundedBox(0.5, 0.36, 0.03, 0.02), M.screen, 0.05, 0.45, -0.33); // rear screen
    // Record tally — the one saturated thing on the whole object.
    add(cam, cyl(0.05, 0.03, 'z', 16), tallyMat, -0.42, 0.72, 0.33);

    /* Lens. Diameters step in and out deliberately: a smooth taper looks
       moulded, a stepped stack looks assembled. */
    const lens = new THREE.Group();
    lens.position.set(-0.07, 0.45, 0.32);
    cam.add(lens);
    add(lens, cyl(0.3, 0.1, 'z'), M.trim, 0, 0, 0.05); // mount
    add(lens, cyl(0.335, 0.28, 'z'), M.body, 0, 0, 0.24); // rear barrel
    add(lens, cyl(0.375, 0.3, 'z', 48), M.grip, 0, 0, 0.53); // zoom ring, rubber
    /* THE RED RING. On the reference lens it is the marque for the
       manufacturer's professional line, and it is the single highest-contrast
       detail on the object. Ours is Ember — the site's own persuasive colour —
       so the one thing the eye lands on is brand rather than someone else's
       badge. It is also why no logo is modelled anywhere on this camera. */
    add(lens, cyl(0.385, 0.055, 'z'), ringMat, 0, 0, 0.71);
    add(lens, cyl(0.36, 0.1, 'z'), M.body, 0, 0, 0.79); // mid barrel
    add(lens, cyl(0.37, 0.22, 'z', 48), M.grip, 0, 0, 0.95); // focus ring
    // Petal hood, flaring forward. Open-ended, so it is a real tube you can see
    // into rather than a capped cone — hence DoubleSide on its material.
    const hoodGeo = new THREE.CylinderGeometry(0.5, 0.385, 0.36, 36, 1, true);
    hoodGeo.rotateX(Math.PI / 2);
    add(lens, hoodGeo, hoodMat, 0, 0, 1.24);
    // Front element, sunk inside the hood so the rim casts on it — a disc flush
    // with the front reads as a lens cap.
    add(lens, new THREE.CircleGeometry(0.34, 44), M.glass, 0, 0, 1.13);
    add(lens, new THREE.RingGeometry(0.34, 0.378, 44), M.trim, 0, 0, 1.145);

    /* ---- Framing -------------------------------------------------------
       Three-quarter from the front left: enough turn to show the depth of the
       body and the length of the lens at once, which a straight-on view hides
       and a profile flattens. */
    /* YAW IS THE WHOLE COMPOSITION, and it is not a taste call.

       The lens points along the rig's +Z, so yaw maps it to (sin, 0, cos).
       Near zero the barrel foreshortens into a flat black disc — the object
       loses its most recognisable feature and reads as a box with a hole in
       it. That is what -0.3 did. The barrel's LENGTH only appears as the
       magnitude approaches a right angle, so this is deliberately steep.

       Negative, not positive, so the lens looks INTO the headline rather than
       off the right edge of the page. The tilt arm lives on the camera's left
       and would foul that turn, except the lens projects far enough forward in
       Z to clear it. */
    const YAW = -0.82;
    const PITCH = 0.1;
    root.rotation.set(PITCH, YAW, 0);
    root.position.y = 0.3; // centre the whole assembly in frame
    root.scale.setScalar(0.99);

    /* ---- Light ---------------------------------------------------------
       The same two practicals as the bloom and as the CSS: tungsten key upper
       right, daylight fill lower left. Plus a magenta kicker BEHIND the rig —
       a near-black object on a near-black ground has no silhouette without a
       rim, and that rim is doing more work here than the key is. */
    const key = new THREE.DirectionalLight(0xffc98a, 4.6);
    key.position.set(4.2, 4.6, 3.4);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x6e9bd1, 0.72);
    fill.position.set(-4.4, -2.2, 2.4);
    scene.add(fill);

    /* Two rims, and they are doing more work than the key is. A near-black
       object on a near-black ground has no silhouette at all without them —
       the first pass had one magenta kicker and the rig read as a bruise.

       They are opposed on purpose: warm Ember down the left edge, where the
       object meets the headline and most needs an outline, and cool Daylight
       down the right, which is the one place a cool accent helps rather than
       tinting the body. Both sit BEHIND the rig, so they catch edges only. */
    const rimWarm = new THREE.PointLight(0xf2704a, 40, 18, 2);
    rimWarm.position.set(-2.6, 1.1, -2.6);
    scene.add(rimWarm);

    const rimCool = new THREE.PointLight(0x7fb4e2, 8, 15, 2);
    rimCool.position.set(3.0, -0.6, -3.4);
    scene.add(rimCool);

    scene.add(new THREE.AmbientLight(0x4a4260, 1.7));

    /* ---- Sizing --------------------------------------------------------
       Where the rig sits, as a fraction of the LAYOUT COLUMN — 0 is the left
       edge of the hero's content box, 1 its right edge. Measured against that
       box and never against the canvas: the canvas is full-bleed, so on a wide
       monitor a viewport-relative fraction throws the rig out to the screen
       edge while the copy stays in its centred container, and the two halves
       of the composition drift apart. */
    const FRAME_X = 0.755;
    const anchor = document.querySelector('[data-rig-anchor]');
    let offsetX = 0;

    const resize = () => {
      const r = gl.getBoundingClientRect();
      if (!r.width || !r.height) return;
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
      renderer.setSize(r.width, r.height, false);

      const b = anchor?.getBoundingClientRect();
      const targetX = b && b.width ? b.left + b.width * FRAME_X : r.left + r.width * FRAME_X;
      const frac = (targetX - r.left) / r.width;

      const worldH = 2 * camera.position.z * Math.tan((camera.fov * Math.PI) / 360);
      offsetX = (frac - 0.5) * worldH * camera.aspect;
    };
    resize();
    addEventListener('resize', resize, { passive: true });

    /* ---- Input ---------------------------------------------------------- */

    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    addEventListener(
      'pointermove',
      (e) => {
        pointer.tx = (e.clientX / innerWidth) * 2 - 1;
        pointer.ty = (e.clientY / innerHeight) * 2 - 1;
      },
      { passive: true }
    );

    let scrolled = 0;
    const onScroll = () => {
      scrolled = Math.min(scrollY / Math.max(innerHeight * 0.8, 1), 1);
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    /* ---- Loop ----------------------------------------------------------- */

    const clock = new THREE.Clock();
    let frame = 0;

    /** The motors' current angles. Held outside the frame because the whole
        point is that they LAG the sway rather than tracking it exactly. */
    const corr = { x: 0, y: 0, z: 0 };

    const start = () => {
      if (frame) return;
      clock.getDelta(); // discard the paused interval
      frame = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (!frame) return;
      cancelAnimationFrame(frame);
      frame = 0;
    };

    const io = new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), {
      threshold: 0,
    });
    io.observe(gl);

    function tick() {
      frame = requestAnimationFrame(tick);
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      /* THE HANDLE'S MOTION. Three sines on deliberately unrelated periods —
         2.3s, 3.1s, 4.7s — so the pattern never visibly repeats. Equal or
         harmonic periods produce a clean figure-of-eight, which reads as a
         machine on a turntable rather than as a person walking. */
      const sx = Math.sin(t * 0.68) * 0.13; // pitch, the walking bob
      const sz = Math.sin(t * 0.51 + 1.1) * 0.16; // roll, the side-to-side
      const sy = Math.sin(t * 0.34 + 2.4) * 0.1; // yaw, the drift
      sway.rotation.set(sx, sy, sz);

      /* THE CORRECTION. Each motor drives toward the negation of the sway, but
         eased rather than snapped. The residual is what you actually watch:
         the horizon dips a few degrees and is pulled back. At a very high
         factor the camera is welded level and the arm looks like one solid
         object; at a very low one the stabilisation visibly fails. Roll is
         given the fastest motor because roll is the axis a viewer reads as
         "level" — a tilted horizon is obvious in a way a little pitch is not. */
      const ease = (cur: number, target: number, k: number) =>
        cur + (target - cur) * Math.min(dt * k, 1);
      corr.x = ease(corr.x, -sx, 4.4);
      corr.y = ease(corr.y, -sy, 3.6);
      corr.z = ease(corr.z, -sz, 5.6);

      pan.rotation.y = corr.y;
      roll.rotation.z = corr.z;
      tilt.rotation.x = corr.x;

      // The record tally breathes rather than blinks. A hard blink pulls the
      // eye off the object every second; a slow pulse says "rolling" quietly.
      tallyMat.emissiveIntensity = 1.15 + Math.sin(t * 1.9) * 0.75;

      // Damped pointer parallax, on top of a slow presentation turn that keeps
      // showing new faces without ever spinning the lens away from the viewer.
      pointer.x += (pointer.tx - pointer.x) * Math.min(dt * 2.4, 1);
      pointer.y += (pointer.ty - pointer.y) * Math.min(dt * 2.4, 1);

      const recede = scrolled;
      root.rotation.y = YAW + Math.sin(t * 0.16) * 0.3 + pointer.x * 0.34;
      root.rotation.x = PITCH + pointer.y * 0.12 - recede * 0.16;
      root.position.x = offsetX + pointer.x * 0.16;
      root.position.y = 0.3 - pointer.y * 0.1 - recede * 0.5;
      root.position.z = -recede * 3.0;

      gl.style.opacity = String((1 - Math.min(recede * 1.3, 1)) * 0.97);

      renderer.render(scene, camera);
    }

    // Compose before the first render, then reveal — otherwise the rig appears
    // centred for one frame and jumps right.
    root.position.x = offsetX;
    renderer.render(scene, camera);
    gl.classList.add('is-live');
    start();

    /* A lost context must not leave a frozen canvas sitting over the fallback.
       preventDefault() is what ASKS for the context back; without a restore
       handler it only guarantees the rig never returns. Chrome drops WebGL
       contexts routinely once enough tabs want one. */
    gl.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      stop();
      gl.classList.remove('is-live');
    });

    gl.addEventListener('webglcontextrestored', () => {
      renderer.resetState();
      resize();
      root.position.x = offsetX;
      renderer.render(scene, camera);
      gl.classList.add('is-live');
      start();
    });
  }
</script>

<style>
  .rig {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  /* --- Static fallback ----------------------------------------------------
     Deliberately quiet: an out-of-focus lens rather than a drawing of one.
     Unlike the homepage this hero already carries `.flare`, so a second
     assertive graphic would be clutter — this only has to stop the right
     column reading as empty. Hidden below the two-column width, where the
     copy runs full-bleed and anything behind it costs the headline contrast. */
  .rig__static {
    position: absolute;
    top: 46%;
    left: 79%;
    width: min(46vw, 560px);
    aspect-ratio: 1;
    translate: -50% -50%;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  @media (min-width: 1100px) {
    .rig__static { opacity: 1; }
  }

  .rig__glow,
  .rig__iris {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .rig__glow {
    background: radial-gradient(
      circle at 42% 38%,
      rgb(242 112 74 / 0.16),
      rgb(155 47 192 / 0.1) 42%,
      transparent 68%
    );
    filter: blur(14px);
  }

  /* One thin ring, off-centre and soft — the suggestion of a barrel catching
     the key light, not an illustration of a camera. */
  .rig__iris {
    inset: 26%;
    border: 1px solid rgb(242 112 74 / 0.22);
    box-shadow:
      inset 0 0 60px rgb(155 47 192 / 0.12),
      0 0 70px rgb(199 67 30 / 0.1);
  }

  /* --- Canvas ------------------------------------------------------------- */
  .rig__gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.1s var(--ease);
  }
  .rig__gl.is-live { opacity: 0.97; }

  /* Once the real object is running, the stand-in gets out of its way. */
  .rig:has(.rig__gl.is-live) .rig__static { opacity: 0; }
</style>

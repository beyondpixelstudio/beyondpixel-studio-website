---
/**
 * Aperture Iris Reveal
 *
 * THE CONSTRAINT THAT SHAPES THIS: hero content is never hidden. Chrome excludes
 * `opacity: 0` elements from Largest Contentful Paint, so gating the page behind
 * the animation would delay LCP by the animation's full length and cost the
 * performance score outright. An element merely COVERED by an opaque overlay
 * still counts as painted — so this is an overlay, and the hero renders normally
 * underneath it from first paint.
 *
 * Blades carry a STATIC clip-path and a STATIC rotation offset; only `transform`
 * and `opacity` animate. Compositor-only — no layout, no repaint.
 *
 * Pure CSS: nothing here waits on JavaScript. If JS fails, the page still opens.
 *
 * PARAMETERISED so the real logo drops in later without a rebuild: change BLADES
 * to the mark's blade count and --iris-ring to its gradient stops.
 */
const BLADES = 9;
const step = 360 / BLADES;
// Half-angle padded 1° past the exact wedge so neighbouring blades overlap
// rather than risk a hairline gap. They are all the same colour, so overlap
// is invisible and a gap would not be.
const half = step / 2 + 1;
const spread = Math.tan((half * Math.PI) / 180) * 50;
const clip = `polygon(50% 50%, 100% ${(50 - spread).toFixed(2)}%, 100% ${(50 + spread).toFixed(2)}%)`;
---

<div class="iris" aria-hidden="true">
  <div class="iris__ring"></div>
  {
    Array.from({ length: BLADES }, (_, i) => (
      <div class="iris__blade" style={`--a:${i * step}deg; clip-path:${clip};`} />
    ))
  }
  <p class="iris__mark">Beyond Pixel</p>
</div>

<script is:inline>
  // Skip the reveal on any interaction — nobody should be trapped watching it.
  (function () {
    var el = document.querySelector('.iris');
    if (!el) return;
    var done = function () {
      el.style.animation = 'none';
      el.style.visibility = 'hidden';
    };
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (evt) {
      window.addEventListener(evt, done, { once: true, passive: true });
    });
    window.setTimeout(function () {
      el.remove();
    }, 1400);
  })();
</script>

<style>
  .iris {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
    animation: irisDone 0s linear 880ms forwards;
  }
  @keyframes irisDone {
    to { visibility: hidden; }
  }

  .iris__blade {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150vmax;
    height: 150vmax;
    margin: -75vmax 0 0 -75vmax;
    background: var(--void);
    transform-origin: 50% 50%;
    /* Closed. The `translateX` runs along the blade's own rotated axis, so the
       apex travels radially outward — an iris opening, not a wipe. */
    transform: rotate(var(--a)) translateX(0);
    animation: bladeOpen 640ms cubic-bezier(.16, 1, .3, 1) 180ms forwards;
    will-change: transform;
  }
  @keyframes bladeOpen {
    to { transform: rotate(calc(var(--a) + 24deg)) translateX(94vmax); }
  }

  /* The ONE signature moment the restraint rule permits: the full gradient
     appears here and nowhere else on the site. */
  .iris__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24vmax;
    height: 24vmax;
    margin: -12vmax 0 0 -12vmax;
    border-radius: 50%;
    background: conic-gradient(
      from .5turn,
      var(--ember), var(--magenta), var(--ocean), var(--tungsten), var(--ember)
    );
    -webkit-mask: radial-gradient(circle, transparent 0 calc(50% - 2px), #000 calc(50% - 2px));
    mask: radial-gradient(circle, transparent 0 calc(50% - 2px), #000 calc(50% - 2px));
    transform: scale(.04);
    opacity: 0;
    animation: ringOut 720ms cubic-bezier(.16, 1, .3, 1) 150ms forwards;
    will-change: transform, opacity;
  }
  @keyframes ringOut {
    18% { opacity: 1; }
    to { transform: scale(9); opacity: 0; }
  }

  /* Placeholder for the real mark. Swap for the logo SVG when it arrives. */
  .iris__mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 700;
    font-size: clamp(20px, 3.4vw, 34px);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0;
    animation: markIn 620ms cubic-bezier(.16, 1, .3, 1) forwards;
  }
  @keyframes markIn {
    0% { opacity: 0; transform: scale(.94); }
    38% { opacity: 1; transform: scale(1); }
    72% { opacity: 1; }
    to { opacity: 0; transform: scale(1.04); }
  }

  /* Once per session. The <head> script stamps this before the overlay paints,
     so repeat visits and internal navigation never sit through it again. */
  :global(html[data-iris='seen']) .iris { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .iris { animation: irisFade 160ms linear forwards; }
    .iris__blade, .iris__ring, .iris__mark { animation: none; }
    .iris__ring { opacity: 0; }
    .iris__mark { opacity: 0; }
  }
  @keyframes irisFade {
    to { opacity: 0; visibility: hidden; }
  }
</style>

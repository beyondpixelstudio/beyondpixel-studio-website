---
import { business } from '../data/business.ts';
import { services } from '../data/services.ts';
---

<header class="hdr">
  <div class="wrap">
    {/* The bar is a FLOATING PILL, detached from the top edge — the reference's
        most recognisable structural move. It keeps the page container's width
        so the brand mark still shares a left edge with the H1 below it; a
        narrower centred pill would look closer to the reference and would put
        two competing left edges back on the page. */}
    <div class="hdr__bar glass">
      <a class="hdr__brand" href="/">
        {/* The MARK only, never the full lockup — the lockup in circulation
            bakes in a superseded tagline and a retired phone number, and an
            image is the one place a wrong NAP cannot be corrected by editing
            business.ts. Decorative: the brand name sits beside it as real text. */}
        <img
          class="hdr__mark"
          src="/logo-mark-128.png"
          alt=""
          width="128"
          height="72"
          decoding="async"
        />
        <span class="hdr__words">
          <span class="hdr__name">Beyond Pixel Studio</span>
          <span class="hdr__tag">{business.tagline}</span>
        </span>
      </a>

      <nav class="hdr__nav" aria-label="Primary">
        {/* A disclosure, not a hover menu. `aria-expanded` on a real <button>
            is what tells assistive tech the state, and click-to-open works for
            keyboard, touch and mouse identically — a hover-only submenu is
            unreachable on touch and awkward with a keyboard. */}
        <div class="hdr__menu" data-menu>
          <button class="hdr__trigger" type="button" aria-expanded="false" aria-controls="hdr-services">
            Services
            <svg class="hdr__chev" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="hdr__panel" id="hdr-services" hidden>
            <ul>
              {services.map((s) => (
                <li>
                  <a href={`/${s.slug}/`}>
                    <span class="hdr__pname">{s.name}</span>
                    <span class="hdr__psum">{s.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href="/work/">Work</a>
        <a href="/#why">Why us</a>
        <a href="/blog/">Blogs</a>
        <a href="/contact/">Contact</a>
      </nav>

      <div class="hdr__act">
        {/* THE SITE HAD NO MOBILE NAVIGATION AT ALL. `.hdr__nav` was
            display:none until 1040px and nothing replaced it, so every visitor
            on a phone OR a tablet could reach exactly two things from the
            header: the logo and the quote button. Six service pages, the work,
            the blog and the contact page were unreachable from the bar on the
            devices most of this audience actually uses. */}
        <button
          type="button"
          class="hdr__burger"
          data-burger
          aria-expanded="false"
          aria-controls="hdr-mobile"
          aria-label="Open menu"
        >
          <span class="hdr__burger-box" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>

        <button
          type="button"
          class="btn btn--ghost hdr__brochure-btn"
          data-open-portfolio
          aria-label="Download 2026 Portfolio Brochure"
        >
          <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 14v3a1 1 0 001 1h12a1 1 0 001-1v-3M10 2v11M6 9l4 4 4-4" />
          </svg>
          <span class="hdr__brochure-txt">Brochure</span>
        </button>
        <a class="hdr__tel mono" href={business.phone.href}>{business.phone.display}</a>
        <a class="btn hdr__cta" href="/contact/" aria-label="Request a Quote">
          <span class="hdr__cta-long">Request a </span>Quote
        </a>
      </div>
    </div>

    {/* One panel, every destination. Rendered from the same `services` array
        the desktop menu uses, so a seventh service appears in both or neither
        — two hand-maintained copies of a nav is how a link goes missing on
        phones only and nobody notices for a month. */}
    <div class="hdr__mobile glass" id="hdr-mobile" hidden>
      <nav aria-label="Mobile">
        <p class="hdr__mgroup">Services</p>
        <ul class="hdr__mlist">
          {services.map((s) => (
            <li><a href={`/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>

        <p class="hdr__mgroup">Studio</p>
        <ul class="hdr__mlist">
          <li><a href="/work/">Work</a></li>
          <li><a href="/#why">Why us</a></li>
          <li><a href="/blog/">Blogs</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>

        <div class="hdr__mfoot">
          <a class="btn hdr__mcall" href={business.phone.href}>Call {business.phone.display}</a>
          <button type="button" class="btn btn--ghost hdr__mbrochure" data-open-portfolio>
            Download brochure (PDF)
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  /* Mobile menu. Inline and dependency-free: this is the only way to navigate
     below 1040px, so it must work on the first paint rather than after a module
     graph resolves. */
  (function () {
    var btn = document.querySelector('[data-burger]');
    var panel = document.getElementById('hdr-mobile');
    if (!btn || !panel) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and returns focus to the control that opened it, so a
    // keyboard user is not dropped at the top of the document.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });

    // Any link inside navigates, so the panel must not still be open on the
    // next page — and on a same-page hash there is no navigation at all, which
    // is the case that would otherwise leave it covering the target.
    panel.addEventListener('click', function (e) {
      if (e.target.closest('a, button')) setOpen(false);
    });

    document.addEventListener('click', function (e) {
      if (!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) setOpen(false);
    });

    /* Crossing into desktop must not leave the panel open behind an inline nav
       that has just reappeared — the CSS hides it, but `hidden` and
       `aria-expanded` would still say open to assistive tech. */
    var wide = window.matchMedia('(min-width: 1040px)');
    (wide.addEventListener ? wide.addEventListener.bind(wide, 'change') : wide.addListener.bind(wide))(
      function (e) { if (e.matches) setOpen(false); }
    );
  })();

  // Services disclosure. Closes on Escape, on a click outside, and on choosing
  // a link — a menu that stays open after navigation is a menu you have to
  // dismiss twice.
  (function () {
    var root = document.querySelector('[data-menu]');
    if (!root) return;
    var btn = root.querySelector('button');
    var panel = root.querySelector('.hdr__panel');

    function set(open) {
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    }

    btn.addEventListener('click', function () {
      set(btn.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) set(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      set(false);
      btn.focus(); // focus must not be left stranded inside a hidden panel
    });

    panel.addEventListener('click', function (e) {
      if (e.target.closest('a')) set(false);
    });
  })();
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 900;
    padding-block: 12px;
    /* The gap above and below the pill has to stay transparent — that is what
       makes it read as floating. A background here would turn it back into a
       conventional bar. */
  }
  .hdr__bar {
    display: flex; align-items: center; gap: var(--s-4);
    min-height: 60px;
    padding-inline: var(--s-4);
    border-radius: var(--r-md);
  }

  .hdr__brand {
    display: flex; align-items: center; gap: var(--s-2);
    text-decoration: none; color: var(--text);
    margin-inline-end: auto; line-height: 1.1;
  }
  .hdr__words { display: flex; flex-direction: column; }
  /* The mark is 128x72 — a WIDE lotus, not a square icon. Exactly ONE dimension
     is set so its ratio can never be overridden by accident, and that dimension
     is HEIGHT: in a horizontal bar what reads is how tall the mark is against
     the bar, and sizing by width instead had it rendering 17px tall, which both
     looked like a bullet point and put the brand link under WCAG 2.2's 24px
     target floor. */
  .hdr__mark {
    height: 34px; width: auto; flex: none;
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / .5));
    transition: transform var(--t-slow) var(--ease);
  }
  .hdr__brand:hover .hdr__mark { transform: rotate(-6deg) scale(1.06); }

  .hdr__name {
    font-family: var(--font-display); font-stretch: var(--display-width);
    font-weight: 600; font-size: 17px; letter-spacing: -.01em;
    white-space: nowrap; /* "Beyond Pixel / Studio" over two lines is not a wordmark */
  }
  .hdr__tag {
    font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--text-dim); font-weight: 500;
  }

  .hdr__nav { display: none; align-items: center; gap: var(--s-4); white-space: nowrap; }
  .hdr__nav > a {
    color: var(--text-muted); text-decoration: none; font-size: 15px;
    padding: 8px 2px; transition: color var(--t-fast) var(--ease);
  }
  .hdr__nav > a:hover { color: var(--text); }

  /* --- Services disclosure ------------------------------------------------ */
  .hdr__menu { position: relative; }
  .hdr__trigger {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 2px; border: 0; background: none; cursor: pointer;
    font: inherit; font-size: 15px; color: var(--text-muted);
    transition: color var(--t-fast) var(--ease);
  }
  .hdr__trigger:hover,
  .hdr__trigger[aria-expanded='true'] { color: var(--text); }
  .hdr__chev { width: 12px; height: 12px; transition: rotate var(--t-fast) var(--ease); }
  .hdr__trigger[aria-expanded='true'] .hdr__chev { rotate: 180deg; }

  .hdr__panel {
    position: absolute; top: calc(100% + 14px); left: 50%;
    translate: -50% 0;
    width: min(560px, 78vw);
    padding: var(--s-2);
    border-radius: var(--r-md);
    background: var(--raised);
    box-shadow: var(--edge), 0 18px 44px rgb(0 0 0 / .55);
    z-index: 10;
  }
  .hdr__panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .hdr__panel a {
    display: grid; gap: 2px;
    padding: 10px var(--s-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    transition: background var(--t-fast) var(--ease);
  }
  .hdr__panel a:hover { background: var(--overlay); }
  .hdr__pname { color: var(--text); font-size: 14px; font-weight: 600; white-space: normal; }
  .hdr__psum { color: var(--text-dim); font-size: 12.5px; white-space: normal; }

  @media (min-width: 900px) {
    .hdr__panel ul { grid-template-columns: 1fr 1fr; }
  }

  .hdr__act { display: flex; align-items: center; gap: var(--s-3); }
  .hdr__brochure-btn {
    min-height: 38px;
    padding: 8px 14px;
    font-size: 13.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: var(--r-sm);
    color: var(--text-muted);
    border: 1px solid rgb(255 255 255 / .12);
    cursor: pointer;
  }
  .hdr__brochure-btn:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / .24);
  }
  .hdr__tel { display: none; color: var(--text); text-decoration: none; font-size: var(--fs-sm); white-space: nowrap; }
  .hdr__tel:hover { color: var(--ember-text); }
  .hdr__cta { min-height: 38px; padding: 8px 16px; font-size: 14px; }

  /* --- Burger + mobile panel -------------------------------------------- */
  .hdr__burger {
    display: inline-grid; place-items: center;
    width: 40px; height: 40px;              /* clears WCAG 2.2's 24px floor with room */
    border-radius: var(--r-sm);
    background: transparent;
    border: 1px solid rgb(255 255 255 / .12);
    color: var(--text);
    cursor: pointer;
    order: 9;                                /* last item in the bar, always */
  }
  .hdr__burger:hover { border-color: rgb(255 255 255 / .28); }
  .hdr__burger-box { display: grid; gap: 4px; width: 17px; }
  .hdr__burger-box span {
    height: 1.6px; border-radius: 2px; background: currentColor;
    transition: transform var(--t-fast, .2s) var(--ease), opacity var(--t-fast, .2s) var(--ease);
  }
  /* Into an X, so the same control obviously closes what it opened. */
  .hdr__burger[aria-expanded='true'] .hdr__burger-box span:nth-child(1) { transform: translateY(5.6px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] .hdr__burger-box span:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded='true'] .hdr__burger-box span:nth-child(3) { transform: translateY(-5.6px) rotate(-45deg); }

  .hdr__mobile {
    margin-top: var(--s-2);
    padding: var(--s-4);
    border-radius: var(--radius);
    max-height: min(72vh, 640px);
    overflow-y: auto;                        /* long service lists on short phones */
    -webkit-overflow-scrolling: touch;
  }
  .hdr__mgroup {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--text-dim);
  }
  .hdr__mlist { list-style: none; margin: 0 0 var(--s-4); padding: 0; display: grid; gap: 2px; }
  .hdr__mlist a {
    display: block;
    padding: 11px var(--s-3);                /* 44px tall — a thumb target, not a link */
    border-radius: var(--r-sm);
    color: var(--text); text-decoration: none; font-size: 15px;
  }
  .hdr__mlist a:hover, .hdr__mlist a:focus-visible { background: var(--overlay); color: var(--ember-text); }
  .hdr__mfoot { display: grid; gap: var(--s-2); }
  .hdr__mcall, .hdr__mbrochure { width: 100%; justify-content: center; min-height: 44px; }

  /* The burger exists only where the inline nav does not. One threshold, and it
     is the SAME 1040 the nav uses — split them and there is a band of widths
     with both or neither. */
  @media (min-width: 1040px) {
    .hdr__burger { display: none; }
    .hdr__mobile { display: none !important; }
  }

  @media (max-width: 620px) {
    .hdr__brochure-btn { display: none; }
  }

  /* Below ~430px the existing 560px reductions still left the bar 27px short:
     `.hdr__name` is `white-space: nowrap`, so flex could not shrink it and the
     wordmark ran under the CTA instead. Dropping "Request a " frees about 80px,
     which is far more than the shortfall, and the brand keeps its full name —
     the identity is worth more here than the verb. `aria-label` holds the full
     "Request a Quote" so the accessible name never shortens with the visual. */
  @media (max-width: 430px) {
    .hdr__cta-long { display: none; }

    /* The burger adds ~48px to a bar that was already tight, leaving the
       wordmark 16px from the CTA — not an overlap, but close enough to read as
       one. `.hdr__name` is nowrap, so flex cannot shrink it; `min-width: 0` on
       the brand is what lets the whole group give ground instead of pushing.
       Nothing is dropped — the mark and the name both survive to 320px. */
    .hdr__brand { min-width: 0; }
    .hdr__words { min-width: 0; }
    .hdr__name { font-size: 13px; }
    .hdr__mark { height: 24px; }
    .hdr__act { flex-shrink: 0; gap: var(--s-2); }
  }

  /* THE TAGLINE IS BACK ON PHONES. It was dropped here to buy horizontal room
     for the CTA, and that reasoning was wrong in one specific way: the tagline
     is STACKED under the wordmark, so it costs width only if it is the wider of
     the two lines. Shrunk and tightened it is narrower than "Beyond Pixel
     Studio", which means it costs nothing horizontally — the space was never
     the tagline's to give back. */
  @media (max-width: 560px) {
    .hdr__bar { padding-inline: var(--s-3); gap: var(--s-3); }
    .hdr__tag { font-size: 8px; letter-spacing: .1em; }
    .hdr__mark { height: 26px; }
    .hdr__brand { gap: var(--s-2); }
    .hdr__name { font-size: 14px; }
    .hdr__cta { padding: 8px 12px; font-size: 13px; min-height: 36px; }
  }
  @media (min-width: 700px) { .hdr__tel { display: inline; } }
  /* 1040, not 900: at 900 the nav, the number and the CTA were all present and
     all wrapping. The nav is the item that can wait. */
  @media (min-width: 1040px) { .hdr__nav { display: flex; } }

  @media (prefers-reduced-motion: reduce) {
    .hdr__brand:hover .hdr__mark { transform: none; }
  }
</style>

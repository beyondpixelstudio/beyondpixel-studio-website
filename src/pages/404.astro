---
/**
 * 404.
 *
 * There was no 404 page at all, so a mistyped URL served whatever Hostinger's
 * LiteSpeed default is — an unbranded error page with no way back. That is a
 * dead end for a visitor and a dead end for a crawler following a stale link
 * from a directory listing or an old brochure.
 *
 * Astro emits this as dist/404.html, which LiteSpeed serves automatically for
 * missing paths without any .htaccess rule.
 *
 * `noindex, follow` is the correct pair and the two halves do different jobs.
 * `noindex` keeps the error page itself out of results. `follow` still lets a
 * crawler that landed here walk the links below into the real pages, which is
 * the entire reason for listing them rather than showing an apology and a
 * single link home.
 */
import Base from '../layouts/Base.astro';
import { business } from '../data/business.ts';
import { services } from '../data/services.ts';
---

<Base
  title="Page not found | Beyond Pixel Studio"
  description="That page does not exist. Here is everything that does — services, work and how to reach the studio in Bhubaneswar."
  robots="noindex, follow"
>

  <section class="shead">
    <span class="flare" aria-hidden="true"></span>
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lead nf__lead">
        The link may be old, or something in the address is off by a character.
        Nothing is lost — everything this studio does is one click away below.
      </p>

      <div class="nf__cta">
        <a class="btn" href="/">Back to the homepage</a>
        <a class="btn btn--ghost" href="/work/">See the work</a>
        <a class="btn btn--ghost" href={business.phone.href}>{business.phone.display}</a>
      </div>
    </div>
  </section>

  <div class="letterbox"></div>

  <section class="section">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Everything else</p>
        <h2>What you were probably looking for.</h2>
      </div>

      <ul class="nf__list">
        {services.map((s) => (
          <li>
            <a href={`/${s.slug}/`}>
              <span class="nf__name">{s.name}</span>
              <span class="nf__sum">{s.summary}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="/work/">
            <span class="nf__name">Our work</span>
            <span class="nf__sum">Films, events and live streams, sorted by the kind of job.</span>
          </a>
        </li>
        <li>
          <a href="/blog/">
            <span class="nf__name">Blogs</span>
            <span class="nf__sum">What we have learned on shoots, written down.</span>
          </a>
        </li>
        <li>
          <a href="/contact/">
            <span class="nf__name">Contact</span>
            <span class="nf__sum">Send a date and a venue, get an itemised quote.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .shead {
    position: relative; z-index: 2;
    padding-block: clamp(48px, 7vw, 88px) clamp(32px, 5vw, 60px);
  }
  .nf__lead { margin-top: var(--s-4); max-width: 52ch; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }

  .nf__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  @media (min-width: 720px) { .nf__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .nf__list { grid-template-columns: repeat(3, 1fr); } }

  .nf__list a {
    display: grid; gap: 5px;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius);
    background: var(--raised);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .07);
    text-decoration: none;
    transition: background var(--t-slow) var(--ease), box-shadow var(--t-slow) var(--ease);
  }
  .nf__list a:hover {
    background: var(--overlay);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ember-text) 42%, transparent);
  }
  .nf__name { color: var(--text); font-weight: 600; font-size: .98rem; }
  .nf__sum { color: var(--text-muted); font-size: .86rem; line-height: 1.45; }
</style>

---
import Base from '../layouts/Base.astro';
import IrisReveal from '../components/IrisReveal.astro';
import LotusBloom from '../components/LotusBloom.astro';
import Check from '../components/Check.astro';
import ClientWall from '../components/ClientWall.astro';
import Reviews from '../components/Reviews.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { business, wa } from '../data/business.ts';
import { getCollection } from 'astro:content';
import { services, generalFaqs } from '../data/services.ts';
import { featuredWork } from '../data/work.ts';
import Faq from '../components/Faq.astro';
import { clients } from '../data/clients.ts';

/**
 * Homepage: highlights only. Its job is to ROUTE, not to sell everything —
 * persuasion happens on the six service pages.
 *
 * The H1 takes the broad category head term. A narrower H1 would compete with
 * /corporate-video-production-bhubaneswar for that page's own keyword.
 */
/* 58 chars. The brand is always written in full — "Beyond Pixel Studio", never
   "Beyond Pixel". The preposition is what got dropped to make room. */
const title = 'Video Production Company Bhubaneswar | Beyond Pixel Studio';
const description =
  'Corporate video production, live event streaming, drone and commercial photography in Bhubaneswar. Own crew, own equipment. Request a custom quote.';

/**
 * The reference's list pattern: a BOLD claim, then a muted qualifier. It scans
 * fast because the eye takes the claim and only reads on if it cares — so the
 * bold half must be the part that is worth something on its own.
 */
const crew = [
  ['Nothing is subcontracted.', 'The people who quote your job are the people who turn up and shoot it.'],
  ['Our own cameras, lights and grip.', 'No rental gaps, no last-minute substitutions on the day.'],
  ['Multi-camera as standard.', 'Interviews cut without jumping; events covered from more than one angle.'],
  ['A call sheet, not a surprise.', 'You know the plan before anyone travels.'],
];

const proof = [
  ['Government and institutional work.', 'Ministerial coverage, PSU and university events — protocol and clearances handled.'],
  ['Rated 5.0 across 91 reviews.', 'Publicly verifiable on JustDial, and on our Google Business Profile.'],
  [`${clients.length} named clients, with their marks on the page.`, clients.slice(0, 4).map((c) => c.name).join(', ') + ' and more.'],
  ['Based in Patia, working across Odisha.', 'One crew, one call, no local fixer to coordinate.'],
];

const process = [
  { n: '01', h: 'Brief', p: 'What it is for, who it is for, and when you need it.' },
  { n: '02', h: 'Plan & quote', p: 'Crew, kit, days and deliverables — itemised, so nothing appears later.' },
  { n: '03', h: 'Production', p: 'We shoot. You get a call sheet, not a surprise.' },
  { n: '04', h: 'Delivery', p: 'Edited, graded, and cut for every platform you actually publish to.' },
];

/** Labelled empty states — honest, and never mistakable for real work. */

/** Newest featured notes. Three, because the strip is a highlight, not an index. */
const posts = (await getCollection('blog'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
---

<Base title={title} description={description} reveal>
  <IrisReveal slot="reveal" />

  {/* ---------------------------------------------------------------- HERO */}
  <section class="hero">
    <LotusBloom />
    <span class="flare" aria-hidden="true"></span>
    <div class="wrap hero__in" data-bloom-anchor>
      <p class="eyebrow">{business.tagline}</p>
      <h1>Video production company in <em>Bhubaneswar</em></h1>
      <p class="lead hero__lead">
        Corporate films, live event streaming and aerial cinematography for companies,
        institutions and government departments across Odisha — shot by our own crew,
        on our own equipment.
      </p>

      <div class="hero__cta">
        <a class="btn btn--lg" href={wa('Hello, I would like a custom quote for a video production.')}>
          Request a custom quote
        </a>
        <button type="button" class="btn btn--ghost btn--lg btn--pdf" data-open-portfolio>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 14v3a1 1 0 001 1h12a1 1 0 001-1v-3M10 2v11M6 9l4 4 4-4" />
          </svg>
          <span>Download Portfolio</span>
        </button>
        <a class="btn btn--ghost btn--lg" href="#work">See our work</a>
      </div>

      <Reviews variant="hero" />
    </div>
  </section>

  {/* ------------------------------------------------------- CLIENT WALL */}
  <section class="section trust" aria-label="Clients">
    <div class="wrap">
      <p class="trust__lead">Trusted by {clients.length}+ brands, campuses and institutions</p>
      {/* FRAMED, not full-bleed. Every other section on the page is boxed to
          --container, and a strip running edge to edge under a boxed hero read
          as a band bolted on from a different design. Inside the container with
          its own rounded frame it becomes a component of the page. */}
      <div class="trust__frame">
        <ClientWall duration={70} />
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- SERVICES */}
  <section class="section glow" id="services" style="--glow: rgb(199 67 30 / .16); --glow-x: 50%; --glow-y: 0%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">What we do</p>
        <h2>Six things, done properly.</h2>
        <p>Every one of them shot by the same crew, on the same equipment, to the same standard.</p>
      </div>

      {/* One perspective for the whole grid, so the cards tilt like a single
          sheet of glass rather than as six independent objects. */}
      <ul class="svc stage">
        {services.map((s, i) => (
          <li class="svc__card panel tilt" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="tilt__sheen" aria-hidden="true"></span>
            {/* NOT `tilt__lift` — see base.css. Its translateZ would make this
                div the containing block for the stretched `h3 a::after`, which
                silently shrinks the whole-card click target to this title row. */}
            <div class="svc__top">
              <h3><a href={`/${s.slug}/`}>{s.name}</a></h3>
              {s.national && <span class="badge badge--quiet svc__flag">Nationwide</span>}
            </div>
            <p class="svc__sum">{s.summary}</p>
            <p class="svc__aud">{s.audience}</p>
            <span class="svc__go" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---------------------------------------------------------------- WHY */}
  <section class="section glow" id="why" style="--glow: rgb(155 47 192 / .15); --glow-x: 30%; --glow-y: 10%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Why Beyond Pixel Studio</p>
        <h2>Reasons that survive a reference check.</h2>
        <p>Not adjectives. Things you can hold us to on the day.</p>
      </div>

      <div class="fstack">
        <article class="panel panel--lit fcard" data-reveal style="--accent: rgb(199 67 30 / .26);">
          <div class="fcard__grid fcard__grid--wide">
            <div class="fcard__body">
              <span class="badge">Our crew</span>
              <h3 class="fcard__h">The people who quote it are the people who shoot it.</h3>
              <ul class="checks">
                {crew.map(([b, rest]) => (
                  <li><Check /><span><b>{b}</b> {rest}</span></li>
                ))}
              </ul>
            </div>
            <div class="fcard__vis">
              <dl class="stat">
                <div><dt>Crew</dt><dd>In-house</dd></div>
                <div><dt>Cameras</dt><dd>Owned</dd></div>
                <div><dt>Coverage</dt><dd>Multi-cam</dd></div>
              </dl>
            </div>
          </div>
        </article>

        <article class="panel panel--lit fcard" data-reveal style="--accent: rgb(27 108 168 / .26);">
          <div class="fcard__grid fcard__grid--wide">
            <div class="fcard__body">
              <span class="badge">Track record</span>
              <h3 class="fcard__h">Work you can check before you commit.</h3>
              <ul class="checks">
                {proof.map(([b, rest]) => (
                  <li><Check /><span><b>{b}</b> {rest}</span></li>
                ))}
              </ul>
            </div>
            <div class="fcard__vis">
              <p class="bigstat">5.0</p>
              <p class="bigstat__note">across 91 reviews on JustDial</p>
              <Reviews variant="block" />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- WORK */}
  <section class="section" id="work">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Selected work</p>
        <h2>Named clients, named events.</h2>
        <p>
          Every photograph here is ours, from the job it is captioned with. Nothing on this
          page is stock and nothing is a mock-up.
        </p>
      </div>

      <ul class="work stage">
        {featuredWork.map((w, i) => (
          <li class="wcard tilt panel" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="tilt__sheen" aria-hidden="true"></span>
            <span class="wcard__media ar-wide">
              <img src={w.image} alt={w.alt} width="1400" height="788" loading="lazy" decoding="async" />
            </span>
            <span class="wcard__body">
              <span class="wcard__client mono">{w.client}{w.year ? ` \u00b7 ${w.year}` : ''}</span>
              <span class="wcard__title">{w.title}</span>
              <span class="wcard__service mono">{w.service}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="work__brochure panel panel--lit" data-reveal style="--accent: rgb(199 67 30 / .26);">
        <div class="work__brochure-in">
          <div class="work__brochure-text">
            <span class="badge">Official 2026 Portfolio</span>
            <h3>Looking for our complete production deck?</h3>
            <p>
              Download our 30-page media brochure containing detailed project case studies,
              broadcast galleries, government & athletic event coverage, and studio specs.
            </p>
          </div>
          <button type="button" class="btn btn--lg work__brochure-btn" data-open-portfolio>
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 14v3a1 1 0 001 1h12a1 1 0 001-1v-3M10 2v11M6 9l4 4 4-4" />
            </svg>
            <span>Download Portfolio (PDF)</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- RECOGNITION
      Straight after Selected work, because that is the order the claim has to
      be read in: here is what we shot, then here is other people saying it was
      done well. Before the work it is an assertion; after it, corroboration.

      LAID OUT AS A FILMSTRIP because the photographs turned out to be 2.04:1 —
      all three, once the black padding the PDF had composited around them was
      trimmed off. That is within a hair of the anamorphic ratio the hero and
      the work cards already use, so three frames in a row reads as a strip of
      film rather than as a gallery. Their natural ratio is kept and no
      aspect-ratio is imposed, which is also why nothing can letterbox again.

      NO AWARD OR AWARDING BODY IS NAMED. The brochure does not name them, and
      inventing a plausible institution on a page read by government and PSU
      buyers is the exact trust problem the brief exists to prevent. The
      photographs carry the specificity; the alt text describes what is visible
      rather than asserting what the award was. */}
  <section class="section glow recog" id="recognition" style="--glow: rgb(155 47 192 / .14); --glow-x: 50%; --glow-y: 8%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Recognised &middot; Trusted &middot; Celebrated</p>
        <h2>Milestones that inspired us.</h2>
        <p class="recog__award">
          Honoured for <em>outstanding media coverage</em> and event broadcasting.
        </p>
      </div>

      {/* Named, on Rajesh's confirmation. These were unattributed until he
          supplied them, and an unattributed award photo is close to worthless
          to the buyer this page is written for — a procurement officer wants to
          know WHO conferred it. Two sitting ministers and a named college is a
          materially stronger claim than "recognised by esteemed organisations",
          and it is checkable, which is the point. */}
      <ul class="recog__strip">
        {[
          {
            src: '/recognition/felicitation-01.webp',
            title: 'Honoured by Suryabanshi Suraj',
            by: 'Minister of Sports & Youth Services, Government of Odisha',
            alt: 'Rajesh Kumar Gouda being presented with a framed certificate on stage by Suryabanshi Suraj, Minister of Sports and Youth Services, Government of Odisha',
          },
          {
            src: '/recognition/felicitation-02.webp',
            title: 'Honoured by Gokula Nanda Mallik',
            by: 'Minister of State (Independent Charge), Fisheries & Animal Resources Development, Odisha',
            alt: 'The Beyond Pixel Studio team receiving a framed commemoration from Gokula Nanda Mallik, Minister of State for Fisheries and Animal Resources Development, Odisha',
          },
          {
            src: '/recognition/felicitation-03.webp',
            title: 'Radiance Sanskruti Puraskar 2025',
            by: 'Radiance College, Bijepur, Bargarh',
            alt: 'Rajesh Kumar Gouda, garlanded, receiving the Radiance Sanskruti Puraskar 2025 from Radiance College, Bijepur, Bargarh',
          },
        ].map((shot, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <figure>
              <img src={shot.src} alt={shot.alt} width="1200" height="589" loading="lazy" decoding="async" />
              <figcaption>
                <span class="recog__title">{shot.title}</span>
                <span class="recog__by">{shot.by}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <p class="recog__note" data-reveal>
        Grateful for the trust and recognition from esteemed organisations and leaders.
        This inspires us to keep creating impact.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ PROCESS */}
  <section class="section">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">How we work</p>
        <h2>Four steps, no mystery.</h2>
      </div>
      <ol class="proc stage">
        {process.map((p, i) => (
          <li class="proc__card panel tilt" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="tilt__sheen" aria-hidden="true"></span>
            <span class="proc__n mono">{p.n}</span>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ------------------------------------------------------- ENQUIRY FORM */}
  {/* --------------------------------------------------------------- NOTES
      Highlights, not an index. Three posts and a link out — the point is to
      show there is thinking behind the service pages, not to publish a feed. */}
  {posts.length > 0 && (
    <section class="section notes" id="blogs">
      <div class="sechead">
        <p class="eyebrow">Blogs</p>
        <h2>Answers we give before anyone signs anything.</h2>
      </div>
      <div class="wrap">
        <ul class="notes__list">
          {posts.map((post, i) => (
            <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <a class="notes__card" href={`/blog/${post.id}/`}>
                <span class="notes__media ar-wide">
                  <img src={post.data.hero} alt={post.data.heroAlt} width="1200" height="675" loading="lazy" decoding="async" />
                </span>
                <span class="notes__kicker mono">{post.data.kicker}</span>
                <span class="notes__title">{post.data.title}</span>
                <span class="notes__desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="notes__all">
          <a class="btn btn--ghost" href="/blog/">Read all blogs</a>
        </p>
      </div>
    </section>
  )}

  {/* ----------------------------------------------------------------- FAQ
      Last thing before the form. Someone who has scrolled this far is close to
      enquiring, and these are the questions that would otherwise stop them. */}
  <Faq
    items={generalFaqs}
    eyebrow="Before you ask"
    heading="Questions we get before the first call."
    schema={false}
  />

  <section class="section glow cta" id="contact" style="--glow: rgb(199 67 30 / .20); --glow-x: 50%; --glow-y: 18%;">
    <div class="wrap">
      <div class="sechead">
        <h2>Tell us what you are planning.</h2>
        <p>
          Send the date, the venue and roughly what you need. You get an itemised
          quote, not a brochure. {business.areaServed.join(', ')} and across
          {' ' + business.areaServedBroad}; AI video production is delivered nationwide.
        </p>
      </div>

      <div class="formwrap" data-reveal>
        <EnquiryForm />
      </div>

      <div class="cta__alt">
        <p>Would rather not fill anything in?</p>
        <div class="cta__btns">
          <a class="btn" href={wa('Hello, I am planning a shoot and would like a quote.')}>
            Message us on WhatsApp
          </a>
          <a class="btn btn--ghost" href={business.phone.href}>{business.phone.display}</a>
          <a class="btn btn--ghost" href={`mailto:${business.email}`}>{business.email}</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* --- Hero --------------------------------------------------------------
     Nothing here is opacity:0 at first paint. The iris covers it; it does not
     gate it. That is what keeps LCP measured at the real paint time. */
  .hero {
    position: relative; z-index: 2;
    /* `.flare` is 135% wide and the bloom rings wider still — decorative, and
       both were extending past the right edge and widening the document. */
    overflow: clip;
    padding-block: clamp(56px, 10vw, 120px) clamp(48px, 8vw, 96px);
    min-height: min(88svh, 860px);
    display: flex; align-items: center;
    isolation: isolate;
  }
  /* `width: 100%` is load-bearing. `.hero` is a flex container so the copy can
     centre vertically, which makes `.wrap` a flex ITEM — and a flex item is
     shrink-to-fit, so the container would collapse to its widest child and
     `margin-inline: auto` would then centre the copy instead of aligning it. */
  /* BOXED, like every other section. This was full-bleed for a while and the
     trade-off noted here at the time is exactly what went wrong: the H1 started
     at the page gutter while the header and every section below started at the
     container edge, so the hero's left edge sat outside theirs. On a wide
     display that also pushed the copy and the bloom to opposite ends of the
     screen and opened a dead gap down the middle.

     Dropping `max-width: none` lets `.wrap`'s 1240 cap apply again, so the hero
     aligns with the header and the sections. The bloom needs no change — it
     resolves its position from `[data-bloom-anchor]`'s content box, so it moves
     in with the copy. */
  .hero__in { position: relative; z-index: 2; width: 100%; }
  /* The copy is a COLUMN, not a full-width block: it keeps the H1 to a readable
     measure and leaves the right of the frame for the bloom. */
  .hero__in > * { max-width: 42rem; }
  /* The bloom is bright at its centre and body copy cannot compete with a
     magenta petal passing behind it. */
  .hero__in::before {
    content: ''; position: absolute; z-index: -1;
    inset: -10% -14% -14% -20%;
    background: radial-gradient(
      62% 68% at 26% 50%,
      color-mix(in srgb, var(--void) 90%, transparent) 0 42%,
      transparent 78%
    );
  }
  h1 :global(em) { font-style: normal; color: var(--ember-text); }
  .hero__lead { margin-top: var(--s-4); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }

  .rating { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-4); flex-wrap: wrap; }
  .rating__stars { color: var(--tungsten); letter-spacing: .12em; font-size: 15px; }
  .rating .mono { font-size: 13px; color: var(--text-muted); }

  /* --- Trust bar ---------------------------------------------------------
     Client names as TEXT: indexable (logos are not) and needing no trademark
     permission. */
  .trust { position: relative; z-index: 2; padding-block: clamp(var(--s-5), 5vw, var(--s-6)); }
  .trust__lead {
    font-size: 13px; letter-spacing: .04em; color: var(--text-dim);
    text-align: center; margin-bottom: var(--s-4);
  }
  /* NO FILL. It carried a flat --surface slab, and against the --void page that
     is a five-value difference — too subtle to read as a designed surface, and
     just visible enough to read as a seam. Its straight left edge was a hard
     vertical line drawn across empty background.

     Removing it costs nothing: the tiles are glass with their own lit edges, the
     rows are already clipped by the rounded box, and the mask on `.wall` fades
     them out at both ends. It also finally gives the tiles something worth
     blurring — a fill of near-black is not a backdrop, the page is. */
  .trust__frame {
    border-radius: var(--r-lg);
    padding-block: var(--s-3);
    overflow: hidden;
  }

  /* --- Services ----------------------------------------------------------- */
  .svc { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .svc__card {
    padding: var(--s-4) var(--s-4) var(--s-5);
    transition: background var(--t-fast) var(--ease);
  }
  /* NO `transform` here. `.svc__card:hover` outranks `.tilt`, so a hover lift
     declared on this rule would silently replace the entire 3D rotation with a
     flat nudge. The lift is the rig's `--lift` instead. */
  .svc__card:hover { background: var(--overlay); }
  .svc__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
  .svc__card h3 a { color: var(--text); text-decoration: none; }
  /* The whole card is the target; the link keeps the accessible name. */
  .svc__card h3 a::after { content: ''; position: absolute; inset: 0; }
  .svc__card:hover h3 a { color: var(--ember-text); }
  .svc__flag { font-size: 11px; padding: 4px 10px 4px 8px; }
  .svc__sum { margin-top: var(--s-3); color: var(--text); font-size: var(--fs-sm); }
  .svc__aud { margin-top: var(--s-1); color: var(--text-muted); font-size: var(--fs-sm); }
  .svc__go { position: absolute; right: var(--s-4); bottom: var(--s-3); color: var(--ember-text); opacity: 0; transition: opacity var(--t-fast) var(--ease), translate var(--t-fast) var(--ease); }
  .svc__card:hover .svc__go { opacity: 1; translate: 4px 0; }

  /* --- Why: the reference's feature-card stack ---------------------------- */
  .fstack { display: grid; gap: var(--s-4); }
  .stat { margin: 0; display: grid; gap: var(--s-3); width: 100%; }
  .stat > div { display: flex; justify-content: space-between; gap: var(--s-3); padding-bottom: var(--s-3); border-bottom: 1px solid rgb(255 255 255 / .07); }
  .stat > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .stat dt { color: var(--text-dim); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  .stat dd { margin: 0; color: var(--text); font-size: var(--fs-sm); font-weight: 600; }

  .bigstat {
    font-family: var(--font-display); font-stretch: var(--display-width);
    font-weight: 500; font-size: clamp(56px, 7vw, 88px); line-height: 1;
    letter-spacing: -.03em; color: var(--text); text-align: center;
  }
  .bigstat__note { margin-top: var(--s-3); margin-bottom: var(--s-4); text-align: center; color: var(--text-muted); font-size: var(--fs-sm); }

  /* --- Work: labelled empty states ---------------------------------------- */
  .work { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .slate {
    display: flex; flex-direction: column; justify-content: space-between;
    padding: var(--s-4);
    background: color-mix(in srgb, var(--void) 60%, transparent);
  }
  /* Framing marks. The 16:9 box is mostly empty by design, so it needs to read
     as a camera frame waiting for a shot — not as a card someone forgot. */
  .slate::before, .slate::after {
    content: ''; position: absolute; width: 15px; height: 15px;
    border-color: rgb(255 255 255 / .18); border-style: solid;
  }
  .slate::before { top: 14px; left: 14px; border-width: 1px 0 0 1px; }
  .slate::after { bottom: 14px; right: 14px; border-width: 0 1px 1px 0; }

---
/**
 * The service page template. ONE file renders all six.
 *
 * Adding or editing a service is a change to services.ts and nothing else —
 * which is the whole point. Six hand-built pages drift apart in structure,
 * schema and tone within a month of the first edit; six renders of one template
 * cannot.
 *
 * Each page carries its own Service schema and a BreadcrumbList. Both are built
 * from the same data that renders the visible page, so structured data and
 * visible content can never disagree — which is the actual requirement Google
 * enforces, and the usual reason a rich result gets dropped.
 */
import Base from '../layouts/Base.astro';
import Check from '../components/Check.astro';
import Faq from '../components/Faq.astro';
import ServiceRig from '../components/ServiceRig.astro';
import { business, wa } from '../data/business.ts';
import { services } from '../data/services.ts';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;

/** Cross-links: every other service, so no page is a dead end. */
const others = services.filter((s) => s.slug !== service.slug);

const where = service.national
  ? 'Delivered nationwide from Bhubaneswar.'
  : `${business.areaServed.join(', ')} and across ${business.areaServedBroad}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: service.description,
  url: `${business.url}/${service.slug}/`,
  provider: { '@id': `${business.url}/#organization` },
  areaServed: service.national
    ? { '@type': 'Country', name: 'India' }
    : business.areaServed.map((c) => ({ '@type': 'City', name: c })),
  // What the job contains, as an itemised offer catalogue. This is the visible
  // list — not a second, more flattering version written for the crawler.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${service.name} — what is included`,
    itemListElement: service.includes.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i },
    })),
  },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: service.name,
      item: `${business.url}/${service.slug}/`,
    },
  ],
};
---

<Base title={service.title} description={service.description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(schema)}
  />
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(breadcrumb)}
  />

  {/* ------------------------------------------------------------- HEADER */}
  <section class="shead">
    <span class="flare" aria-hidden="true"></span>
    {service.rig && <ServiceRig rig={service.rig} />}
    <div class="wrap" data-rig-anchor>
      <div class="shead__copy">
        <nav class="crumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">{service.name}</li>
          </ol>
        </nav>

        <span class="badge shead__badge">{service.national ? 'Nationwide' : 'Bhubaneswar, Odisha'}</span>
        <h1>{service.h1}</h1>
        <p class="lead shead__lead">{service.intro}</p>

        <div class="shead__cta">
          <a class="btn" href={wa(service.whatsapp)}>Enquire on WhatsApp</a>
          <button
            type="button"
            class="btn btn--ghost"
            data-open-portfolio
            data-portfolio-purpose={service.name}
          >
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 14v3a1 1 0 001 1h12a1 1 0 001-1v-3M10 2v11M6 9l4 4 4-4" />
            </svg>
            <span>Download Portfolio (PDF)</span>
          </button>
          <a class="btn btn--ghost" href={business.phone.href}>{business.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="letterbox"></div>

  {/* ------------------------------------------------------------- DETAIL */}
  <section class="section glow" style="--glow: rgb(199 67 30 / .14); --glow-x: 50%; --glow-y: 0%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">The job itself</p>
        <h2>Itemised, so nothing appears later.</h2>
        <p>What is in the quote, and what lands in your hands at the end of it.</p>
      </div>

      <div class="fstack">
        <article class="panel panel--lit fcard" data-reveal style="--accent: rgb(199 67 30 / .24);">
          <div class="fcard__grid fcard__grid--wide">
            <div class="fcard__body">
              <span class="badge">What is included</span>
              <h3 class="fcard__h">Every line is something you can check we did.</h3>
              <ul class="checks">
                {service.includes.map((i) => (
                  <li><Check /><span>{i}</span></li>
                ))}
              </ul>
            </div>
            <div class="fcard__vis">
              <p class="vis__k mono">{service.national ? 'Nationwide' : 'Bhubaneswar & Odisha'}</p>
              <p class="vis__v">{where}</p>
            </div>
          </div>
        </article>

        <article class="panel panel--lit fcard" data-reveal style="--accent: rgb(27 108 168 / .24);">
          <div class="fcard__grid fcard__grid--wide">
            <div class="fcard__body">
              <span class="badge">What you receive</span>
              <h3 class="fcard__h">Deliverables, named before we start.</h3>
              <ul class="checks checks--cool">
                {service.deliverables.map((d) => (
                  <li><Check /><span>{d}</span></li>
                ))}
              </ul>
            </div>
            <div class="fcard__vis">
              <a class="btn btn--lg" href={wa(service.whatsapp)}>Enquire on WhatsApp</a>
              <p class="vis__v vis__v--mid">Send the date and the venue. You get an itemised quote.</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- WORK */}
  <section class="section section--band">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Selected work</p>
        <h2>Frames reserved for this service.</h2>
        <p>
          Empty and labelled on purpose. Footage from real {service.name.toLowerCase()} jobs
          drops into these slots — we would rather show you nothing than show you stock.
        </p>
      </div>
      <ul class="slates stage">
        {[1, 2, 3].map((n) => (
          <li class="slate ar-wide tilt panel" data-reveal style={`--reveal-delay:${n * 60}ms`}>
            <span class="tilt__sheen" aria-hidden="true"></span>
            <div class="slate__head">
              <span class="mono">SLATE 0{n}</span>
              <span class="mono slate__cat">{service.portfolio.replace('-', ' / ')}</span>
            </div>
            <dl class="slate__meta mono">
              <div><dt>CLIENT</dt><dd>—</dd></div>
              <div><dt>RUNTIME</dt><dd>—:—:—:—</dd></div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="letterbox"></div>

  {/* ------------------------------------------------------------ OTHERS */}
  <section class="section">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Also from Beyond Pixel Studio</p>
        <h2>The rest of what we do.</h2>
      </div>
      <ul class="more stage">
        {others.map((s, n) => (
          <li class="more__card panel tilt" data-reveal style={`--reveal-delay:${n * 50}ms`}>
            <span class="tilt__sheen" aria-hidden="true"></span>
            <h3><a href={`/${s.slug}/`}>{s.name}</a></h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------------- FAQ
      Before the CTA on purpose: these are the objections that stop someone
      enquiring, so they belong between the pitch and the ask. */}
  <Faq items={service.faqs} heading={`${service.name} — questions we get asked`} />

  {/* ---------------------------------------------------------- FINAL CTA */}
  <section class="section glow cta" style="--glow: rgb(199 67 30 / .18); --glow-x: 50%; --glow-y: 40%;">
    <div class="wrap cta__in" data-reveal>
      <h2>Tell us what you are planning.</h2>
      <p class="lead cta__lead">
        Send the date, the venue and roughly what you need. You get an itemised quote,
        not a brochure.
      </p>
      <div class="shead__cta cta__btns">
        <a class="btn btn--lg" href={wa(service.whatsapp)}>Enquire on WhatsApp</a>
        <button
          type="button"
          class="btn btn--ghost btn--lg"
          data-open-portfolio
          data-portfolio-purpose={service.name}
        >
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 14v3a1 1 0 001 1h12a1 1 0 001-1v-3M10 2v11M6 9l4 4 4-4" />
          </svg>
          <span>Download Portfolio (PDF)</span>
        </button>
        <a class="btn btn--ghost btn--lg" href="/contact/">All contact details</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .shead {
    position: relative; z-index: 2;
    padding-block: clamp(40px, 6vw, 76px) clamp(32px, 5vw, 60px);
  }
  .shead__badge { margin-bottom: var(--s-4); }
  .shead h1 { max-width: 20ch; }

  /* The copy has to sit ABOVE the canvas, which is `inset: 0` on the section.
     Without a stacking context of its own the rig paints over the headline. */
  .shead__copy { position: relative; z-index: 2; }

  /* The two-column hero, and it is keyed off `.is-live` rather than a media
     query on purpose.

     `.is-live` only appears once ServiceRig's gates have all passed — width,
     reduced-motion, WebGL, memory. So the column narrows exactly when there is
     something in the right half to narrow FOR, and never on a machine that
     fell back to the static treatment. The 1100px threshold therefore lives in
     one file (the component's WIDE) instead of two that can drift apart.

     The media query below is still needed: `.is-live` says the rig is running,
     not that the viewport is currently wide enough — resizing a live canvas
     down must put the copy back to full width. */
  @media (min-width: 1100px) {
    .shead:has(.rig__gl.is-live) .shead__copy { max-width: 57%; }
    /* Give the rig room to be seen at full height. Without this the hero is
       sized entirely by the copy and the object gets cropped top and bottom on
       the shorter service pages. */
    .shead:has(.rig__gl.is-live) { min-height: 33rem; display: flex; align-items: center; }
    .shead:has(.rig__gl.is-live) > .wrap { width: 100%; }
  }
  .shead__lead { margin-top: var(--s-4); }
  .shead__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }

  /* --- Breadcrumb --------------------------------------------------------- */
  .crumb ol {
    list-style: none; margin: 0 0 var(--s-4); padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--s-2);
    font-size: 13px; color: var(--text-muted);
  }
  .crumb li + li::before { content: '/'; margin-right: var(--s-2); color: var(--text-dim); }
  /* Padded to clear WCAG 2.2's 24px target floor. A breadcrumb is navigation —
     a list of discrete controls — not prose, so the "inline in a sentence"
     exception does not cover it. */
  .crumb a { display: inline-block; padding-block: 4px; color: var(--text-muted); text-decoration: none; }
  .crumb a:hover { color: var(--ember-text); }

  /* --- Feature-card stack ------------------------------------------------- */
  .fstack { display: grid; gap: var(--s-4); }
  /* The deliverables list is the cool half of the pair, so its ticks take the
     ocean hue rather than Ember. Ember persuades; this one only informs. */
  .checks--cool :global(.checks__m) { color: var(--daylight); }
  .vis__k { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); text-align: center; }
  .vis__v { margin-top: var(--s-3); color: var(--text-muted); font-size: var(--fs-sm); text-align: center; max-width: 30ch; }
  .vis__v--mid { margin-top: var(--s-4); }

  /* --- Slates and cross-links --------------------------------------------- */
  .slates, .more { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .slate {
    display: flex; flex-direction: column; justify-content: space-between;
    padding: var(--s-4);
    background: color-mix(in srgb, var(--void) 60%, transparent);
  }
  .slate::before, .slate::after {
    content: ''; position: absolute; width: 15px; height: 15px;
    border-color: rgb(255 255 255 / .18); border-style: solid;
  }
  .slate::before { top: 14px; left: 14px; border-width: 1px 0 0 1px; }
  .slate::after { bottom: 14px; right: 14px; border-width: 0 1px 1px 0; }
  .slate__head { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .16em; color: var(--text-muted); }
  .slate__cat { color: var(--daylight); text-transform: uppercase; }
  .slate__meta { margin: 0; display: grid; gap: var(--s-1); font-size: 11px; color: var(--text-dim); }
  .slate__meta > div { display: flex; gap: var(--s-2); }
  .slate__meta dt { letter-spacing: .14em; min-width: 68px; }
  .slate__meta dd { margin: 0; }

  .more__card { padding: var(--s-4); transition: background var(--t-fast) var(--ease); }
  /* NO transform here — it would outrank `.tilt` and flatten the 3D rotation. */
  .more__card:hover { background: var(--overlay); }
  .more__card h3 a { color: var(--text); text-decoration: none; }
  .more__card h3 a::after { content: ''; position: absolute; inset: 0; }
  .more__card:hover h3 a { color: var(--ember-text); }
  .more__card p { margin-top: var(--s-2); font-size: var(--fs-sm); color: var(--text-muted); }

  /* --- CTA ---------------------------------------------------------------- */
  .cta__in { text-align: center; display: grid; justify-items: center; }
  .cta__lead { margin-top: var(--s-4); }
  .cta__btns { justify-content: center; }

  @media (max-width: 479px) {
    .shead__cta { flex-direction: column; align-items: stretch; }
    .shead__cta .btn { width: 100%; }
  }
  @media (min-width: 620px) {
    .slates, .more { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 980px) {
    .slates { grid-template-columns: repeat(3, 1fr); }
    .more { grid-template-columns: repeat(3, 1fr); }
  }
</style>

---
/**
 * Contact.
 *
 * The ONLY page where the alternate number and the manager mailbox appear.
 * Everywhere else — header, footer, schema, meta — carries the primary line
 * alone. That is deliberate: directories and aggregators scrape whatever is
 * most prominent and most repeated, so a second number given equal weight on
 * every page is how a business ends up with two "official" numbers in
 * circulation and a diluted NAP. Here it is labelled an alternate, which is
 * what it is.
 *
 * THE FORM COMPOSES A WHATSAPP MESSAGE; it does not post anywhere. A static
 * site has nowhere to POST to, and the alternatives — a third-party form
 * endpoint, or an inbox nobody watches mid-shoot — are worse than the channel
 * this market already uses. The details are assembled in the browser and handed
 * to WhatsApp, where the sender still presses send. See EnquiryForm.astro.
 */
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Reviews from '../components/Reviews.astro';
import Social from '../components/Social.astro';
import { business, wa } from '../data/business.ts';
import { services } from '../data/services.ts';

const title = 'Contact Beyond Pixel Studio | Patia, Bhubaneswar';
const description =
  'Call, WhatsApp or email Beyond Pixel Studio in Patia, Bhubaneswar for corporate video, event streaming, drone and studio bookings across Odisha.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${business.url}/contact/` },
  ],
};

const lines = [
  {
    label: 'Phone & WhatsApp',
    note: 'Primary line. Fastest response.',
    display: business.phone.display,
    tel: business.phone.href,
    waHref: wa('Hello, I would like to enquire about a shoot.'),
    primary: true,
  },
  {
    label: 'Alternate line',
    note: 'If the primary line is engaged — often during a shoot.',
    display: business.phoneAlt.display,
    tel: business.phoneAlt.href,
    waHref: wa('Hello, I would like to enquire about a shoot.', 'alt'),
    primary: false,
  },
];

const mail = [
  {
    label: 'General enquiries',
    addr: business.email,
    note: 'Quotes, new projects, and anything not yet booked.',
  },
  {
    label: 'Production desk',
    addr: business.emailManager,
    note: 'Jobs already booked — call sheets, schedules, deliverables.',
  },
];
---

<Base title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(breadcrumb)}
  />

  <section class="chead">
    <span class="flare" aria-hidden="true"></span>
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <span class="badge chead__badge">Patia, Bhubaneswar</span>
      <h1>Tell us what you are planning.</h1>
      <p class="lead chead__lead">
        Send the date, the venue and roughly what you need. You get an itemised quote,
        not a brochure. WhatsApp is the quickest way to reach us — a message there
        lands with someone, not in a queue.
      </p>
    </div>
  </section>

  <div class="letterbox"></div>

  {/* --------------------------------------------------------------- LINES */}
  <section class="section">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Call or message</p>
        <h2>Two lines. One studio.</h2>
        <p>WhatsApp reaches someone directly. The alternate line is there for when the first is on a shoot.</p>
      </div>

      <ul class="lines stage">
        {lines.map((l, i) => (
          <li
            class:list={['line', 'panel', 'tilt', { 'line--alt': !l.primary }]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="tilt__sheen" aria-hidden="true"></span>
            <p class="line__label mono">{l.label}</p>
            <a class="line__num" href={l.tel}>{l.display}</a>
            <p class="line__note">{l.note}</p>
            <a class="btn line__wa" href={l.waHref}>WhatsApp this line</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---------------------------------------------------------------- MAIL */}
  <section class="section glow" style="--glow: rgb(27 108 168 / .13); --glow-x: 50%; --glow-y: 0%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Email</p>
        <h2>Two mailboxes.</h2>
        <p>So a live shoot never waits behind a general enquiry.</p>
      </div>
      <ul class="mail">
        {mail.map((m, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="mail__label mono">{m.label}</p>
            <a class="mail__addr" href={`mailto:${m.addr}`}>{m.addr}</a>
            <p class="mail__note">{m.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="letterbox"></div>

  {/* --------------------------------------------------------------- VISIT */}
  <section class="section">
    <div class="wrap visit">
      <div>
        <p class="eyebrow">Studio</p>
        <h2 data-reveal>Where to find us.</h2>
        {/* The canonical NAP string, rendered verbatim from business.ts. */}
        <address class="visit__addr">{business.address.display}</address>
        <p class="visit__note">
          The studio is a working floor — please call or message before visiting, so
          someone is there and a shoot is not in progress.
        </p>
        <a class="btn btn--ghost visit__map" href={business.social.googleBusiness}>
          Open in Google Maps
        </a>
      </div>

      <div>
        <p class="eyebrow">Coverage</p>
        <h2 data-reveal>Where we work.</h2>
        <p class="lead">
          {business.areaServed.join(', ')} and across {business.areaServedBroad} — one
          crew, one call, no local fixer to coordinate.
        </p>
        <p class="visit__note">
          AI video production is delivered nationwide and needs no travel at all.
        </p>

        <p class="eyebrow visit__soc">Follow us</p>
        <Social size="lg" />
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- FORM */}
  <section class="section glow" id="enquiry" style="--glow: rgb(199 67 30 / .16); --glow-x: 50%; --glow-y: 10%;">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Send an enquiry</p>
        <h2>Tell us the date and the venue.</h2>
        <p>
          Fill this in and it opens WhatsApp with everything already written out.
          Nothing leaves this page until you press send.
        </p>
      </div>
      <div class="formwrap" data-reveal>
        <EnquiryForm />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ QUICK ENQUIRY */}
  <section class="section">
    <div class="wrap">
      <div class="sechead">
        <p class="eyebrow">Or straight to the point</p>
        <h2>Message us about one service.</h2>
        <p>
          Each of these opens WhatsApp with the service already named, so the first
          reply can be about your dates rather than about what you meant.
        </p>
      </div>
      <ul class="quick">
        {services.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 45}ms`}>
            <a href={wa(s.whatsapp)}>
              <span>{s.name}</span>
              <span class="quick__go mono" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="revwrap"><Reviews variant="block" /></div>
    </div>
  </section>

</Base>

<style>
  .chead { position: relative; z-index: 2; padding-block: clamp(40px, 6vw, 76px) clamp(32px, 5vw, 60px); }
  .chead__badge { margin-bottom: var(--s-4); }
  .chead__lead { margin-top: var(--s-4); }

  .crumb ol {
    list-style: none; margin: 0 0 var(--s-4); padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--s-2); font-size: 13px; color: var(--text-muted);
  }
  .crumb li + li::before { content: '/'; margin-right: var(--s-2); color: var(--text-dim); }
  /* Padded to clear WCAG 2.2's 24px target floor. A breadcrumb is navigation —
     a list of discrete controls — not prose, so the "inline in a sentence"
     exception does not cover it. */
  .crumb a { display: inline-block; padding-block: 4px; color: var(--text-muted); text-decoration: none; }
  .crumb a:hover { color: var(--ember-text); }

  /* --- Lines ---------------------------------------------------------------
     The primary carries the Ember edge. The alternate is deliberately quieter —
     equal visual weight is exactly how a second number becomes a second
     "official" number in the directories. */
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .line { padding: var(--s-5) var(--s-4) var(--s-5); box-shadow: var(--edge-hot); }
  .line--alt { box-shadow: var(--edge); }
  .line__label { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--ember-text); }
  .line--alt .line__label { color: var(--text-dim); }
  .line__num {
    display: inline-block; margin-top: var(--s-2);
    font-family: var(--font-display); font-stretch: var(--display-width);
    font-weight: 500; font-size: clamp(24px, 3vw, 32px);
    color: var(--text); text-decoration: none; letter-spacing: -.02em;
  }
  .line__num:hover { color: var(--ember-text); }
  .line__note { margin-top: var(--s-2); font-size: var(--fs-sm); color: var(--text-muted); }
  .line__wa { margin-top: var(--s-4); }

  /* --- Mail ---------------------------------------------------------------- */
  .mail { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .mail__label { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); }
  .mail__addr { display: inline-block; margin-top: var(--s-2); font-size: var(--fs-lead); color: var(--ocean-text); text-decoration: none; word-break: break-word; }
  .mail__addr:hover { text-decoration: underline; }
  .mail__note { margin-top: var(--s-1); font-size: var(--fs-sm); color: var(--text-muted); }

  /* --- Visit --------------------------------------------------------------- */
  .visit { display: grid; gap: var(--s-6); }
  .visit__addr { font-style: normal; margin-top: var(--s-4); font-size: var(--fs-lead); color: var(--text); max-width: 30ch; }
  .visit__note { margin-top: var(--s-3); font-size: var(--fs-sm); color: var(--text-muted); max-width: 46ch; }
  .visit__map { margin-top: var(--s-4); }
  .visit__soc { margin-top: var(--s-5); margin-bottom: var(--s-3); }

  /* --- Quick enquiry ------------------------------------------------------- */
  .quick { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .quick a {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-3);
    min-height: 56px; padding: 12px var(--s-4);
    background: var(--raised); box-shadow: var(--edge);
    border-radius: var(--r-sm); color: var(--text); text-decoration: none;
    transition: background var(--t-fast) var(--ease);
  }
  .quick a:hover { background: var(--overlay); }
  .quick__go { color: var(--ember-text); }

  .formwrap { max-width: 940px; margin-inline: auto; }
  .revwrap { margin-top: var(--s-6); }

  @media (min-width: 700px) {
    .lines { grid-template-columns: repeat(2, 1fr); }
    .mail { grid-template-columns: repeat(2, 1fr); }
    .quick { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 980px) {
    .visit { grid-template-columns: 1fr 1fr; gap: var(--s-7); }
  }
</style>

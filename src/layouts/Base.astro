---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, sameAs } from '../data/business.ts';

interface Props {
  title: string;
  description: string;
  /** Homepage only — the reveal does not run on internal navigation. */
  reveal?: boolean;
}
const { title, description, reveal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * LocalBusiness schema, built from business.ts so the NAP in structured data
 * can never disagree with the NAP on the page.
 *
 * NOTE the absence of `aggregateRating`. The 5.0/91 rating is real but lives on
 * JustDial; Google disallows marking up third-party ratings as first-party, and
 * self-serving aggregateRating is the one abuse that draws manual actions. The
 * rating is displayed visually instead, where it still does its job.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${business.url}/#organization`,
  name: business.name,
  description,
  url: business.url,
  telephone: business.phone.e164,
  email: business.email,
  founder: { '@type': 'Person', name: business.founder.name },
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  areaServed: [
    ...business.areaServed.map((c) => ({ '@type': 'City', name: c })),
    { '@type': 'State', name: business.areaServedBroad },
  ],
  sameAs,
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="IN-OR" />
    <meta name="geo.placename" content={business.address.locality} />
    <meta name="theme-color" content="#14102A" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />

    <script is:inline>
      // Runs before first paint. Two jobs, both of which must happen early:
      //   1. `.js` gates the reveal styles, so content is visible by default and
      //      a JS failure can never leave the page blank.
      //   2. the session stamp suppresses the iris on repeat visits, before the
      //      overlay has a chance to paint.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (sessionStorage.getItem('bps-iris')) d.dataset.iris = 'seen';
          else sessionStorage.setItem('bps-iris', '1');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {reveal && <slot name="reveal" />}

    <div class="cine" aria-hidden="true">
      <div class="cine__bloom"></div>
      <div class="cine__vignette"></div>
      <div class="cine__grain"></div>
    </div>

    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline>
      // Rack focus: blur(9px) -> 0. One observer, fires once, then unobserves.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tunnel from '../components/Tunnel.astro';
import Bubbles from '../components/Bubbles.astro';
import { business, sameAs } from '../data/business.ts';

interface Props {
  title: string;
  description: string;
  /** Homepage only — the reveal does not run on internal navigation. */
  reveal?: boolean;
}
const { title, description, reveal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * LocalBusiness schema, built from business.ts so the NAP in structured data
 * can never disagree with the NAP on the page.
 *
 * NOTE the absence of `aggregateRating`. The 5.0/91 rating is real but lives on
 * JustDial; Google disallows marking up third-party ratings as first-party, and
 * self-serving aggregateRating is the one abuse that draws manual actions. The
 * rating is displayed visually instead, where it still does its job.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${business.url}/#organization`,
  name: business.name,
  description,
  url: business.url,
  telephone: business.phone.e164,
  email: business.email,
  founder: { '@type': 'Person', name: business.founder.name },
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  areaServed: [
    ...business.areaServed.map((c) => ({ '@type': 'City', name: c })),
    { '@type': 'State', name: business.areaServedBroad },
  ],
  sameAs,
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="IN-OR" />
    <meta name="geo.placename" content={business.address.locality} />
    <meta name="theme-color" content="#05040B" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />

    {/* Page-specific structured data. The LocalBusiness block above is emitted
        on every page and carries @id, so a Service or Breadcrumb graph injected
        here can reference the organisation rather than restating its NAP — one
        entity, described once, linked to from everywhere. */}
    <slot name="head" />

    <script is:inline>
      // Runs before first paint. Two jobs, both of which must happen early:
      //   1. `.js` gates the reveal styles, so content is visible by default and
      //      a JS failure can never leave the page blank.
      //   2. the session stamp suppresses the iris on repeat visits, before the
      //      overlay has a chance to paint.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (sessionStorage.getItem('bps-iris')) d.dataset.iris = 'seen';
          else sessionStorage.setItem('bps-iris', '1');
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {reveal && <slot name="reveal" />}

    <div class="cine" aria-hidden="true">
      <Tunnel />
      <Bubbles />
      <div class="cine__bloom"></div>
      <div class="cine__vignette"></div>
      <div class="cine__grain"></div>
    </div>

    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline>
      // Rack focus: blur(9px) -> 0. One observer, fires once, then unobserves.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <script is:inline>
      // Pointer rig.
      //
      // Writes --mx/--my (-1..1) ONCE on <html>. Anything that wants to lean
      // towards the pointer reads those instead of adding its own listener —
      // six bubbles with six listeners would be six closures firing on every
      // mouse move, for one number they all share.
      //
      // Skipped entirely on a coarse pointer: there is no cursor to follow, and
      // registering the listener would cost a frame on every touch-drag.
      (function () {
        if (!matchMedia('(pointer: fine)').matches) return;
        if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return;

        var d = document.documentElement;
        var queued = false;
        var x = 0;
        var y = 0;

        function write() {
          queued = false;
          d.style.setProperty('--mx', x.toFixed(3));
          d.style.setProperty('--my', y.toFixed(3));
        }

        addEventListener(
          'pointermove',
          function (e) {
            x = (e.clientX / innerWidth) * 2 - 1;
            y = (e.clientY / innerHeight) * 2 - 1;
            // rAF-coalesced: pointermove can fire well above display rate and
            // writing a custom property more than once a frame is wasted work.
            if (!queued) { queued = true; requestAnimationFrame(write); }
          },
          { passive: true }
        );
      })();
    </script>

    <script is:inline>
      // Tilt rig.
      //
      // Refuses to start under reduced motion or on a coarse pointer — a tilt
      // that tracks a finger fights the scroll it is competing with, and on
      // touch the card is under the thumb that would be reading it.
      //
      // ONE listener on the document, not one per card. Twenty cards each
      // holding their own pointermove handler is twenty closures firing on
      // every mouse move; this fires once and writes only to the card currently
      // under the pointer.
      (function () {
        var fine = matchMedia('(pointer: fine)').matches;
        var ok = matchMedia('(prefers-reduced-motion: no-preference)').matches;
        if (!fine || !ok) return;

        var MAX = 7;       // degrees — past ~10 a tilt reads as a gimmick
        var active = null;
        var queued = false;
        var last = null;

        function clear(el) {
          el.classList.remove('is-tracking');
          el.style.setProperty('--rx', '0deg');
          el.style.setProperty('--ry', '0deg');
          el.style.setProperty('--lift', '0px');
        }

        function apply() {
          queued = false;
          if (!active || !last) return;
          var r = active.getBoundingClientRect();
          if (!r.width || !r.height) return;
          // -0.5..0.5 from the card's own centre
          var px = (last.clientX - r.left) / r.width - 0.5;
          var py = (last.clientY - r.top) / r.height - 0.5;
          // Y follows X, X inverts Y: pushing the top of a card away tips it
          // back, which is the direction a physical card would go.
          active.style.setProperty('--ry', (px * MAX * 2).toFixed(2) + 'deg');
          active.style.setProperty('--rx', (-py * MAX * 2).toFixed(2) + 'deg');
          active.style.setProperty('--lift', '-4px');
          active.style.setProperty('--gx', (px * 100 + 50).toFixed(1) + '%');
          active.style.setProperty('--gy', (py * 100 + 50).toFixed(1) + '%');
        }

        document.addEventListener(
          'pointermove',
          function (e) {
            var el = e.target instanceof Element ? e.target.closest('.tilt') : null;
            if (el !== active) {
              if (active) clear(active);
              active = el;
              if (active) active.classList.add('is-tracking');
            }
            if (!active) return;
            last = e;
            // rAF-coalesced: a pointermove can fire well above display rate,
            // and writing a transform more than once a frame is wasted work.
            if (!queued) { queued = true; requestAnimationFrame(apply); }
          },
          { passive: true }
        );

        // Leaving the window entirely never fires a move over a non-card.
        document.addEventListener('pointerleave', function () {
          if (active) { clear(active); active = null; }
        });
      })();
    </script>
  </body>
</html>
